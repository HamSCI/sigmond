# /etc/systemd/system/sigmond-drift.timer
[Unit]
Description=Sigmond drift report, daily
Documentation=https://github.com/HamSCI/sigmond

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
# Persistent=true: a host that was down at midnight reports on its next boot.
Persistent=true

[Install]
WantedBy=timers.target
