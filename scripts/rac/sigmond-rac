#!/bin/bash
# sigmond-rac - the remote-access entry point for a bare-metal sigmond machine.
#
#   sigmond-rac register [--site NAME]   register with the RAC gateway now
#   sigmond-rac retry                    one retry pass (the timer runs this)
#   sigmond-rac activate [--site NAME]   set remote access up on this machine
#
# Run as root.  It sources the Proxmox wizard as a library, in station mode,
# and calls the wizard's own registration functions.
#
# Exit codes: register/retry 0 done, 1 failed (the reason is printed).
#   activate: the switch's own code, or 2 bad arguments, 4 no station name,
#   5 this machine belongs to a Proxmox host's RAC, 6 --site differs from the
#   recorded name, 7 the old wd-rac tunnel still runs here.
#
# Activate also clones the sigmond-rac payload (frpc and the CA) when the
# machine holds none.  It clones as root, then chowns the checkout to the
# owner of /opt/git/sigmond/sigmond.
#
# Test overrides: SIGMOND_WIZARD, SIGMOND_RAC_MARK_DIR, SIGMOND_RAC_LOG,
#   SIGMOND_RAC_LINK, SIGMOND_RAC_APPLIANCE_VERSION, SIGMOND_RAC_PAIR_KEY,
#   SIGMOND_RAC_PAYLOAD_URL, SIGMOND_RAC_PAYLOAD_TARGET,
#   SIGMOND_RAC_PAYLOAD_OWNER_REF, SIGMOND_RAC_PAYLOAD_DIRS.
set -u

verb="${1:-}"
[ "$#" -gt 0 ] && shift
site_arg=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --site) [ "$#" -ge 2 ] || { echo "sigmond-rac: --site needs a name" >&2; exit 2; }
                site_arg="$2"; shift 2 ;;
        --site=*) site_arg="${1#--site=}"; shift ;;
        *) echo "sigmond-rac: unknown argument: $1" >&2; exit 2 ;;
    esac
done
case "$verb" in
    register|retry|activate) ;;
    *) echo "usage: sigmond-rac register|retry|activate [--site NAME]" >&2; exit 2 ;;
esac

SELF=$(readlink -f "$0")
WIZARD="${SIGMOND_WIZARD:-$(dirname "$SELF")/../proxmox/sigmond-wizard.sh}"
[ -r "$WIZARD" ] || { echo "sigmond-rac: cannot read the wizard at $WIZARD" >&2; exit 1; }

RAC_MODE=station
[ -n "$site_arg" ] && export SIGMOND_RAC_SITE="$site_arg"
export RAC_MODE
set --
SIGMOND_WIZARD_AS_LIB=1
ERRLOG="${SIGMOND_RAC_LOG:-/var/log/sigmond-rac.log}"
{ : >> "$ERRLOG"; } 2>/dev/null || ERRLOG=/dev/null
# shellcheck disable=SC1090
source "$WIZARD" 2>>"$ERRLOG"
RAC_MODE=station
if ! declare -F rac_register >/dev/null || ! declare -F rac_install_host_files >/dev/null; then
    echo "sigmond-rac: the wizard at $WIZARD did not load its RAC functions (see $ERRLOG)" >&2
    exit 1
fi

# The wizard's setup fixed these for a Proxmox host; set ours after it.
MARK_DIR="${SIGMOND_RAC_MARK_DIR:-$MARK_DIR}"
export SIGMOND_RAC_MARK_DIR="$MARK_DIR"
LOG="${SIGMOND_RAC_LOG:-/var/log/sigmond-rac.log}"
say(){ echo "[sigmond-rac] $*"; echo "[sigmond-rac] $*" >> "$LOG" 2>/dev/null; return 0; }

case "$verb" in
register)
    if rac_register fresh; then
        say "registered: RAC #$(cat "$MARK_DIR/rac-number" 2>/dev/null) via $(cat "$MARK_DIR/rac-tier" 2>/dev/null)"
        exit 0
    fi
    say "not registered: $RAC_FAIL"
    exit 1 ;;
retry)
    rac_retry
    exit $? ;;
activate)
    APPL_VER="${SIGMOND_RAC_APPLIANCE_VERSION:-/etc/sigmond-appliance/version}"
    PAIR_KEY="${SIGMOND_RAC_PAIR_KEY:-/etc/sigmond/rac-switch.key}"
    if [ -e "$APPL_VER" ] || [ -e "$PAIR_KEY" ]; then
        echo "sigmond-rac: a Proxmox host carries this machine's RAC; nothing to activate here." >&2
        exit 5
    fi
    # The old tunnel (wd-rac) and this one must not run together: a second
    # registration would give the machine a second RAC number.  Spec section 6.
    old=$( { systemctl list-unit-files --no-legend --plain 'wd-rac.service' 'wd-rac@*.service' 2>/dev/null \
                 | awk '$2 == "enabled" {print $1}'
             systemctl list-units --no-legend --plain 'wd-rac.service' 'wd-rac@*.service' 2>/dev/null \
                 | awk '$3 == "active" {print $1}'; } | grep -v '^wd-rac@\.service$' | sort -u | tr '\n' ' ')
    if [ -n "${old// /}" ]; then
        {
            echo "sigmond-rac: this machine still runs the old wd-rac tunnel (${old% }), so activate stops here."
            echo "A second tunnel would give it a second RAC number.  To move it to the new tunnel:"
            echo "  1. sudo systemctl disable --now 'wd-rac@*' wd-rac.service"
            echo "  2. sudo /opt/git/sigmond/sigmond/scripts/rac/sigmond-rac activate"
            echo "The new tunnel gets a new RAC number and new ports."
        } >&2
        exit 7
    fi
    site=$(rac_site_name)
    if [ -z "$site" ]; then
        if [ -n "$site_arg" ]; then
            echo "sigmond-rac: the --site you gave ($site_arg) sanitises to nothing; use letters, digits, - or _" >&2
        else
            echo "sigmond-rac: no station name: set [station] callsign in /etc/sigmond/site-profile.toml or pass --site" >&2
        fi
        exit 4
    fi
    if [ -n "$site_arg" ]; then
        # What --site means with no recorded name; a recorded name must match it.
        wanted=$(MARK_DIR=/nonexistent/none rac_site_name)
        if [ "$wanted" != "$site" ]; then
            echo "sigmond-rac: this machine is recorded as $site; --site names $wanted. To rename deliberately, remove $MARK_DIR/rac-site and rerun with --site" >&2
            exit 6
        fi
    fi
    # Fetch the frpc payload when this machine holds none.  `smd install
    # sigmond-rac` would run the guest installer, the wrong one.
    if [ ! -x "$RAC_FRPC" ] || [ ! -f "$RAC_CA" ] || [ ! -f "$RAC_CA_GW2" ] || [ ! -f "$RAC_CA_HAMSCI" ]; then
        found=""
        pdirs="${SIGMOND_RAC_PAYLOAD_DIRS:-${SIGMOND_RAC_PAYLOAD:+$SIGMOND_RAC_PAYLOAD:}/root/sigmond-appliance/sigmond-rac:/opt/git/sigmond/sigmond-rac}"
        IFS=: read -ra pda <<< "$pdirs"
        for pd in "${pda[@]}"; do
            [ -n "$pd" ] && [ -x "$pd/install-host.sh" ] && { found=1; break; }
        done
        # An old checkout has install-host.sh but not the per-gateway CAs, so
        # even running it leaves them out.  Bring it forward as its owner.
        if [ -n "$found" ] && [ -d "$pd/.git" ] \
           && { [ ! -f "$pd/frps-ca-gw2.crt" ] || [ ! -f "$pd/frps-ca-hamsci.crt" ]; }; then
            powner=$(stat -c %U "$pd" 2>/dev/null || echo root)
            say "updating the sigmond-rac payload in $pd"
            if [ "$powner" = "$(id -un)" ]; then pull=(git -C "$pd" pull --quiet --ff-only)
            else pull=(runuser -u "$powner" -- git -C "$pd" pull --quiet --ff-only); fi
            if ! "${pull[@]}" >>"$LOG" 2>&1; then
                echo "sigmond-rac: cannot update the sigmond-rac payload in $pd (git pull --ff-only failed; see $LOG)" >&2
                exit 1
            fi
        fi
        if [ -z "$found" ]; then
            purl="${SIGMOND_RAC_PAYLOAD_URL:-https://github.com/HamSCI/sigmond-rac}"
            ptarget="${SIGMOND_RAC_PAYLOAD_TARGET:-/opt/git/sigmond/sigmond-rac}"
            pref="${SIGMOND_RAC_PAYLOAD_OWNER_REF:-/opt/git/sigmond/sigmond}"
            say "fetching the sigmond-rac payload from $purl"
            mkdir -p "$(dirname "$ptarget")" 2>/dev/null
            if ! git clone --quiet "$purl" "$ptarget" >>"$LOG" 2>&1; then
                echo "sigmond-rac: cannot clone the sigmond-rac payload from $purl into $ptarget (see $LOG)" >&2
                exit 1
            fi
            # Own it like the other checkouts there.
            chown -R "$(stat -c %U:%G "$pref" 2>/dev/null || echo root:root)" "$ptarget" 2>/dev/null
            export SIGMOND_RAC_PAYLOAD="$ptarget"
        fi
    fi
    # Run the payload's installer on every activate: an already-registered
    # machine never reaches rac_register, so frpc and the gateway CAs would
    # stay missing.  rac_payload_ready runs install-host.sh only when needed.
    if ! rac_payload_ready; then
        echo "sigmond-rac: the payload install did not produce frpc and the gateway CAs (see $LOG)" >&2
        exit 1
    fi
    mkdir -p "$MARK_DIR" || exit 1
    printf '%s\n' "$site" > "$MARK_DIR/rac-site" || exit 1
    # The switch calls this path to register, so it must exist before `on`.
    LINK="${SIGMOND_RAC_LINK:-/usr/local/sbin/sigmond-rac}"
    mkdir -p "$(dirname "$LINK")" 2>/dev/null
    ln -sf "$SELF" "$LINK" || { echo "sigmond-rac: cannot link $LINK" >&2; exit 1; }
    rac_install_host_files || { echo "sigmond-rac: cannot install the switch and retry unit" >&2; exit 1; }
    # Carry the operator's wish: write one only when none exists.
    if [ ! -s "$MARK_DIR/rac-desired" ]; then
        printf 'on\n' > "$MARK_DIR/rac-desired"
        printf 'on %s install\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$MARK_DIR/rac-changed"
    fi
    if [ "$(tr -d '[:space:]' < "$MARK_DIR/rac-desired")" = off ]; then word=status; else word=on; fi
    out=$(SIGMOND_RAC_BY=install "$RAC_SWITCH" "$word"); rc=$?
    printf '%s\n' "$out"
    exit $rc ;;
esac
