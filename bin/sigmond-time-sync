#!/usr/bin/env python3
"""sigmond-time-sync — make sure chrony disciplines the clock to servers that answer.

WSPR/FT8 decoding needs the clock within a second of UTC and the timing chain
needs far better.  Sites have quietly lost that with no time daemon at all,
and (N8UR, 2026-09-06) with systemd-timesyncd polling only a DHCP-advertised
LAN server that never answered — timesyncd does not fall back to its pools
while a DHCP server is configured, so the clock drifted 7 s slow and one
WARNING line was all anyone got.  Ported from wsprdaemon's wd-time-sync.sh.

  sigmond-time-sync --apply [--wait N]
      1. chrony installed and active; systemd-timesyncd / ntp / ntpsec
         stopped and masked (they fight chrony for the clock)
      2. well-known public pools added as EXTRA sources in
         /etc/chrony/sources.d/sigmond.sources (chrony >= 4) or a marked
         block in chrony.conf.  Distro, DHCP and LAN stratum-1 servers stay
         and win when they answer; the pools make sure SOMETHING does
      3. `makestep 1 -1` in a marked block at the END of chrony.conf: the
         last makestep wins and the distro's `makestep 1 3` follows its
         confdir include, so a conf.d file could not override it
      4. with --wait N, `chronyc waitsync` up to N seconds, then complain
         loudly if the clock is still not synchronised
  sigmond-time-sync --check
      the timer's mode: log ERROR while unsynchronised, one line on recovery

topology.toml:
  [time_sync]
  manage  = false                  # this site runs its own time setup: only check
  servers = ["pool.ntp.org", ...]  # the extra pool sources (default below)
  max_offset_s = 1.0               # 'synchronised' also means |offset| below this
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import List, Optional, Sequence

TOPOLOGY = Path("/etc/sigmond/topology.toml")
CHRONY_CONF = Path("/etc/chrony/chrony.conf")
SOURCES_FILE = Path("/etc/chrony/sources.d/sigmond.sources")
STATE_PATH = Path("/var/lib/sigmond/time-sync.json")
LOG_PATH = Path("/var/log/sigmond/time-sync.log")
MARK_BEGIN = "# BEGIN sigmond time-sync (managed by sigmond-time-sync; do not hand-edit this block)"
MARK_END = "# END sigmond time-sync"
DEFAULT_SERVERS = ["pool.ntp.org", "time.google.com", "time.cloudflare.com", "time.nist.gov"]
CONFLICTING = ["systemd-timesyncd", "ntp", "ntpsec"]


def _log(msg: str) -> None:
    line = f"sigmond-time-sync: {msg}"
    print(line, flush=True)
    if msg.startswith(("ERROR", "WARNING")):
        print(line, file=sys.stderr, flush=True)
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a") as fh:
            fh.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + msg + "\n")
    except OSError:
        pass


def _run(cmd: Sequence[str], timeout: int = 120) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(list(cmd), 124, "", str(exc))


# ─── pure helpers (tested) ─────────────────────────────────────────────────────

@dataclass(frozen=True)
class Tracking:
    stratum: int
    offset_s: float          # system time minus NTP time, seconds
    leap: str                # "Normal" | "Not synchronised" | …
    ref_name: str


def parse_tracking_csv(line: str) -> Optional[Tracking]:
    """`chronyc -c tracking` → one CSV line:
    refid,name,stratum,reftime,offset,lastoffset,rms,freq,residfreq,skew,
    rootdelay,rootdisp,update,leap"""
    f = (line or "").strip().split(",")
    if len(f) < 14:
        return None
    try:
        return Tracking(int(f[2]), float(f[4]), f[13].strip(), f[1])
    except ValueError:
        return None


def is_synced(t: Optional[Tracking], max_offset_s: float) -> bool:
    return (t is not None and t.stratum > 0 and t.leap.lower() != "not synchronised"
            and abs(t.offset_s) <= max_offset_s)


def render_sources(servers: Sequence[str]) -> str:
    body = "\n".join(f"pool {s} iburst" for s in servers)
    return ("# Extra NTP sources added by sigmond (sigmond-time-sync; [time_sync].servers in\n"
            "# /etc/sigmond/topology.toml).  Servers from chrony.conf, conf.d and DHCP are still\n"
            "# used and win when they answer; these make sure SOMETHING answers.\n" + body + "\n")


def with_managed_block(conf_text: str, block_lines: Sequence[str]) -> str:
    """conf_text with exactly one marked block, at the END, containing block_lines."""
    pattern = re.compile(re.escape(MARK_BEGIN) + r".*?" + re.escape(MARK_END) + r"\n?", re.S)
    base = pattern.sub("", conf_text).rstrip("\n")
    block = "\n".join([MARK_BEGIN, *block_lines, MARK_END])
    return (base + "\n\n" if base else "") + block + "\n"


def has_sourcedir(conf_text: str) -> bool:
    return re.search(r"^\s*sourcedir\s+/etc/chrony/sources\.d", conf_text, re.M) is not None


def read_settings() -> dict:
    cfg = {"manage": True, "servers": list(DEFAULT_SERVERS), "max_offset_s": 1.0}
    try:
        import tomllib
        with TOPOLOGY.open("rb") as fh:
            ts = tomllib.load(fh).get("time_sync", {}) or {}
        if "manage" in ts:
            cfg["manage"] = bool(ts["manage"])
        if ts.get("servers"):
            cfg["servers"] = [str(s) for s in ts["servers"]]
        if ts.get("max_offset_s") is not None:
            cfg["max_offset_s"] = float(ts["max_offset_s"])
    except Exception:
        pass
    return cfg


# ─── system-touching ──────────────────────────────────────────────────────────

def tracking() -> Optional[Tracking]:
    r = _run(["chronyc", "-c", "tracking"], timeout=15)
    return parse_tracking_csv(r.stdout) if r.returncode == 0 else None


def sources_report() -> str:
    r = _run(["chronyc", "sources", "-v"], timeout=15)
    return r.stdout if r.returncode == 0 else "(chronyc sources failed)"


def ensure_chrony_installed() -> bool:
    if shutil.which("chronyd") or Path("/usr/sbin/chronyd").exists():
        return True
    _log("installing chrony (apt removes systemd-timesyncd / ntp / ntpsec, which conflict)")
    r = _run(["apt-get", "install", "-y", "chrony"], timeout=600)
    if r.returncode != 0:
        _log(f"ERROR: apt-get install chrony failed: {r.stderr.strip()[-300:]}")
        return False
    return True


def retire_conflicting() -> None:
    for unit in CONFLICTING:
        state = _run(["systemctl", "is-enabled", unit]).stdout.strip()
        if state and state not in ("masked", "not-found", "disabled"):
            _log(f"stopping and masking {unit} (fights chrony for the clock)")
        _run(["systemctl", "stop", unit])
        _run(["systemctl", "mask", unit])


def configure(servers: Sequence[str]) -> bool:
    """Write sources + makestep.  Returns True when anything changed."""
    if not CHRONY_CONF.exists():
        _log(f"ERROR: {CHRONY_CONF} does not exist — chrony is not installed the way this expects")
        return False
    conf = CHRONY_CONF.read_text()
    changed = False
    block = ["# step the clock for any offset over 1 s at any time, not only during chrony's first 3 updates",
             "makestep 1 -1"]
    if has_sourcedir(conf):
        want = render_sources(servers)
        if not SOURCES_FILE.exists() or SOURCES_FILE.read_text() != want:
            SOURCES_FILE.parent.mkdir(parents=True, exist_ok=True)
            SOURCES_FILE.write_text(want)
            _log(f"wrote {SOURCES_FILE}: {' '.join(servers)}")
            changed = True
    else:
        block = [f"pool {s} iburst" for s in servers] + block
    new = with_managed_block(conf, block)
    if new != conf:
        backup = CHRONY_CONF.with_suffix(".conf.bak-sigmond")
        if not backup.exists():
            shutil.copy2(CHRONY_CONF, backup)
        CHRONY_CONF.write_text(new)
        _log(f"updated {CHRONY_CONF}: managed block with makestep 1 -1 at the end (backup {backup.name})")
        changed = True
    return changed


def restart_chrony_checked() -> bool:
    r = _run(["systemctl", "restart", "chrony"], timeout=60)
    if r.returncode != 0 or _run(["systemctl", "is-active", "--quiet", "chrony"]).returncode != 0:
        _log("ERROR: chrony refused the new configuration — rolling the managed block back")
        conf = CHRONY_CONF.read_text()
        CHRONY_CONF.write_text(with_managed_block(conf, []).replace(MARK_BEGIN + "\n" + MARK_END + "\n", ""))
        SOURCES_FILE.unlink(missing_ok=True)
        _run(["systemctl", "restart", "chrony"], timeout=60)
        return False
    return True


def wait_sync(seconds: int, max_offset_s: float) -> None:
    _log(f"waiting up to {seconds}s for chrony to synchronise the clock")
    # waitsync <max-tries> <max-correction> <max-skew (0 = any)> <interval>
    _run(["chronyc", "waitsync", str(max(1, (seconds + 1) // 2)), str(max_offset_s), "0", "2"],
         timeout=seconds + 15)


def complain(t: Optional[Tracking], max_offset_s: float) -> None:
    what = ("chronyd is not running or not answering" if t is None else
            f"stratum {t.stratum}, offset {t.offset_s:+.3f} s, leap status '{t.leap}' "
            f"(need stratum > 0, |offset| <= {max_offset_s} s)")
    _log(f"ERROR: the system clock is NOT synchronised: {what}.\n"
         f"    Decoding needs the clock within a second of UTC; spots will be missed or mis-timed until fixed.\n"
         f"    Sources and what they answered:\n{sources_report()}"
         f"    Fix: 'systemctl status chrony' if it is not running; otherwise make sure UDP/123 to the servers\n"
         f"    above is reachable (firewall?), or set [time_sync].servers in {TOPOLOGY} to servers this host can reach.")


def load_state() -> dict:
    try:
        return json.loads(STATE_PATH.read_text())
    except Exception:
        return {}


def save_state(state: dict) -> None:
    try:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        STATE_PATH.write_text(json.dumps(state))
    except Exception:
        pass


def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--apply", action="store_true", help="install/configure chrony as described")
    g.add_argument("--check", action="store_true", help="report and log the sync state (timer mode)")
    g.add_argument("--show", action="store_true", help="print tracking + sources")
    ap.add_argument("--wait", type=int, default=0, metavar="SECS",
                    help="with --apply: wait this long for sync before complaining")
    args = ap.parse_args(argv)
    cfg = read_settings()

    if args.show:
        print(_run(["chronyc", "tracking"]).stdout, end="")
        print(sources_report(), end="")
        return 0

    if args.apply:
        if not cfg["manage"]:
            _log("[time_sync].manage = false — this site manages its own time; checking only")
        else:
            if not ensure_chrony_installed():
                return 1
            retire_conflicting()
            changed = configure(cfg["servers"])
            if _run(["systemctl", "is-active", "--quiet", "chrony"]).returncode != 0:
                _run(["systemctl", "enable", "--now", "chrony"], timeout=60)
                changed = True
            if changed and not restart_chrony_checked():
                return 1
            if changed:
                time.sleep(3)
        if args.wait:
            wait_sync(args.wait, cfg["max_offset_s"])

    t = tracking()
    synced = is_synced(t, cfg["max_offset_s"])
    st = load_state()
    if synced:
        if st.get("unsynced_since"):
            _log(f"recovered: clock synchronised (stratum {t.stratum}, offset {t.offset_s:+.6f} s via {t.ref_name})")
        elif not args.check:
            _log(f"clock synchronised: stratum {t.stratum}, offset {t.offset_s:+.6f} s via {t.ref_name}")
        st["unsynced_since"] = None
        save_state(st)
        return 0
    st["unsynced_since"] = st.get("unsynced_since") or time.time()
    save_state(st)
    complain(t, cfg["max_offset_s"])
    return 1


if __name__ == "__main__":
    sys.exit(main())
