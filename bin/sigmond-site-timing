#!/bin/bash
# sigmond-site-timing — wire hf-timestd's timing chain to the local site.
# Runs INSIDE the decoder VM (or on a bare-metal station).  Lives in sigmond;
# install.sh links /usr/local/sbin/sigmond-site-timing to this file, so every
# smd update carries it.  Run by the wizard, firstrun bring-up, the
# location check and smd align, and safe to rerun any time
# (every step skips when already wired). Encodes what used to be manual
# post-install work (rob 2026-07-29: NO manual-only fixes — anything the
# live station needed by hand must be in the greenfield flow):
#   1. chrony refclocks for the timestd FUSE/HPPS feed
#   2. LAN stratum-1 NTP: wire the servers the operator trusts; OFFER the rest
#      (sudo sigmond-site-timing --trust-ntp <addr>; record in lan-trust.toml)
#   3. metrology channel env files (from [station]) + per-channel instances
#   4. LAN GNSS stream (:9000): wire the host the operator trusts; OFFER one
#      found (sudo sigmond-site-timing --trust-gnss <addr>)
#   4.9 T6 from a TS-1 the operator declared (ts1 trust), shared by splitter
#   5. timestd profile "full"
#   6. hs-uploader key ownership repair (sigmond#41 family, until upstream fix)
set -u
# This script runs through the /usr/local/sbin link to sigmond's checkout.
# Siblings it needs (lib/sigmond, bin/sigmond-ts1-advertise) come from the
# checkout it really lives in; the fixed paths are the fallback for a plain
# copy left by an older install.
_ST_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)
_ST_LIB=/opt/git/sigmond/sigmond/lib
[ -f "$_ST_ROOT/lib/sigmond/sdr_map.py" ] && _ST_LIB="$_ST_ROOT/lib"
_ST_TS1_ADVERTISE=/usr/local/sbin/sigmond-ts1-advertise
[ -x "$_ST_ROOT/bin/sigmond-ts1-advertise" ] && _ST_TS1_ADVERTISE="$_ST_ROOT/bin/sigmond-ts1-advertise"
say(){ echo "[site-timing] $*" | systemd-cat -t sigmond-site-timing -p notice; }
# smd refuses to run when SUDO_USER is set, and a person runs this script with
# sudo.  Every smd call below goes through this wrapper, which clears SUDO_*
# (sigmond-location-check does the same for `smd config render`).
smd(){ env -u SUDO_USER -u SUDO_UID -u SUDO_GID -u SUDO_COMMAND smd "$@"; }

# ── the LAN trust record ────────────────────────────────────────────────────
# A LAN reply is no authority: any host can answer stratum 1 on UDP 123 or
# speak UBX on :9000, and steps 2 and 4 used to wire whatever answered into
# chrony and [gnss_vtec] (security review, 2026-11-15).  Discovery now OFFERS
# and the operator adopts, as with the TS-1 (`ts1 trust`).  The adoption
# lands in /etc/sigmond/lan-trust.toml:
#     [ntp]   servers = ["192.168.8.144"]
#     [gnss]  host = "192.168.8.50"
# written by this script's own flags, so the one command works on a VM and on
# bare metal alike (`sigmond-setup --ntp` exists only on a Proxmox host):
#     sudo sigmond-site-timing --trust-ntp <addr>    add a LAN NTP server
#     sudo sigmond-site-timing --untrust-ntp <addr>  drop one
#     sudo sigmond-site-timing --trust-gnss <addr>   the LAN GNSS stream host
#     sudo sigmond-site-timing --untrust-gnss
#     sigmond-site-timing --show-trust
# A trust flag records, then runs the wiring (add --no-run to record only).
# Already wired before the record existed, and so trusted as it stands: every
# server in local-timeservers.conf, whatever the wizard wrote to
# 10-sigmond-ntp.conf (the operator named it), and a [gnss_vtec] host that is
# set.  Nothing here removes a working time source.
LAN_TRUST=${LAN_TRUST_FILE:-/etc/sigmond/lan-trust.toml}
LAN_TRUST_NOTED=${LAN_TRUST_NOTED_FILE:-/var/lib/sigmond/lan-trust-legacy.noted}
lan_trust() {   # lan_trust get-ntp | get-gnss | add-ntp A | del-ntp A | set-gnss A | del-gnss | show
    python3 - "$LAN_TRUST" "$@" <<'PYEOF'
import ipaddress, os, sys, tomllib
path, verb, arg = sys.argv[1], sys.argv[2], (sys.argv[3] if len(sys.argv) > 3 else '')
try:
    with open(path, 'rb') as f:
        t = tomllib.load(f)
except FileNotFoundError:
    t = {}
except (OSError, tomllib.TOMLDecodeError) as e:
    sys.exit('%s unreadable (%s) - fix or remove it' % (path, e))
def addr(v):
    try:
        return str(ipaddress.ip_address(v))
    except (ValueError, TypeError):
        return None
ntp = [a for a in (addr(v) for v in (t.get('ntp') or {}).get('servers', []) or []) if a]
gnss = addr((t.get('gnss') or {}).get('host'))
if verb == 'get-ntp':
    print('\n'.join(ntp)); sys.exit(0)
if verb == 'get-gnss':
    print(gnss or ''); sys.exit(0)
if verb == 'show':
    print('LAN NTP servers trusted: %s' % (', '.join(ntp) or 'none'))
    print('LAN GNSS host trusted:   %s' % (gnss or 'none'))
    print('(record: %s)' % path); sys.exit(0)
if verb in ('add-ntp', 'del-ntp', 'set-gnss'):
    a = addr(arg)
    if a is None:
        sys.exit('%r is not an IP address - the trust record holds addresses only' % arg)
if verb == 'add-ntp':
    ntp = ntp + [a] if a not in ntp else ntp
elif verb == 'del-ntp':
    ntp = [x for x in ntp if x != a]
elif verb == 'set-gnss':
    gnss = a
elif verb == 'del-gnss':
    gnss = None
else:
    sys.exit('unknown verb %s' % verb)
out = ['# LAN time sources the operator trusts; sigmond-site-timing wires only these.',
       '# Change with: sudo sigmond-site-timing --trust-ntp/--untrust-ntp/--trust-gnss/--untrust-gnss',
       '[ntp]', 'servers = [%s]' % ', '.join('"%s"' % x for x in ntp), '', '[gnss]']
if gnss:
    out.append('host = "%s"' % gnss)
text = '\n'.join(out) + '\n'
tomllib.loads(text)
os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    f.write(text)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
print('recorded in %s' % path)
PYEOF
}
lan_noted_once() {   # lan_noted_once <key>: true the first time only
    grep -qxF "$1" "$LAN_TRUST_NOTED" 2>/dev/null && return 1
    mkdir -p "$(dirname "$LAN_TRUST_NOTED")" 2>/dev/null
    echo "$1" >> "$LAN_TRUST_NOTED" 2>/dev/null
    return 0
}
if [ $# -gt 0 ]; then
    _run=1; _rc=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --trust-ntp)    lan_trust add-ntp "${2:-}" || _rc=2; shift 2 || shift ;;
            --untrust-ntp)  lan_trust del-ntp "${2:-}" || _rc=2; shift 2 || shift ;;
            --trust-gnss)   lan_trust set-gnss "${2:-}" || _rc=2; shift 2 || shift ;;
            --untrust-gnss) lan_trust del-gnss || _rc=2; shift ;;
            --show-trust)   lan_trust show || _rc=2; _run=0; shift ;;
            --no-run)       _run=0; shift ;;
            *) echo "usage: sigmond-site-timing [--trust-ntp ADDR] [--untrust-ntp ADDR] [--trust-gnss ADDR] [--untrust-gnss] [--show-trust] [--no-run]" >&2
               exit 2 ;;
        esac
    done
    [ "$_rc" = 0 ] || exit "$_rc"
    [ "$_run" = 1 ] || exit 0
fi
command -v timestd >/dev/null 2>&1 || { say "hf-timestd not installed - skipping"; exit 0; }
CFG=/etc/hf-timestd/timestd-config.toml
SUBNET=$(ip -4 route | awk '/proto kernel/{print $1; exit}')
# ⛔ Since v3.50 the VM's own route is the host-only 10.99.0.0/30 behind the
# PM, so scanning it finds nothing: AC0G-ND (v3.67, 2026-10-05) missed BOTH
# its LAN stratum-1 (T4) and its VTEC box on 192.168.8.0/24.  The wizard
# records the PM's site LAN in /etc/sigmond/site-lan; scan that instead.
if [ -s /etc/sigmond/site-lan ] && [[ "$SUBNET" == 10.99.0.* || -z "$SUBNET" ]]; then
    SUBNET=$(head -1 /etc/sigmond/site-lan | tr -d '[:space:]')
fi
# Discovery scans at most 1024 addresses.  Say so ONCE, here, through the
# journal: otherwise both scans below report "none found" for a network
# they never looked at.
if [ -n "$SUBNET" ]; then
    _nsub=$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_network(sys.argv[1], strict=False).num_addresses)' "$SUBNET" 2>/dev/null)
    [ "${_nsub:-0}" -gt 1024 ] && say "site LAN $SUBNET too large to scan ($_nsub addresses) - LAN stratum-1 and GNSS discovery SKIPPED, not empty"
fi

# ── 1. chrony refclocks (FUSE/HPPS) ─────────────────────────────────────────
#
# ⛔ ONE canonical drop-in name: timestd-refclocks.conf.
#
# hf-timestd's own installer (scripts/install.sh:849-861) copies the same
# source file to that name AND retires a legacy `chrony-timestd-refclocks.conf`
# if it finds one — "Disabled legacy duplicate refclock drop-in".  This block
# used to copy the source under ITS OWN basename and guard only on that name,
# so it was blind to the canonical file and re-created the very duplicate
# hf-timestd had just removed.  Both files then declared `refclock SHM 1 FUSE`
# and `refclock SHM 2 HPPS`, chrony loaded each twice, and the second copy of
# each sat at Reach 0 forever — it reads the same SHM segment after the first
# has consumed the sample.
#
# Observed live on AC0G-ND 2026-09-03: install.sh wrote the canonical file at
# 23:48, this script wrote the duplicate at 00:23, and line ~52 below then
# restarted chrony onto a doubled source list.  B4 shows the same collision
# was hit and hand-cleaned on 2026-08-16 (chrony-timestd-refclocks.conf
# .legacy-removed-20260816 still sits in its conf.d) without the code being
# fixed, so every station rebuilt since has re-created it.
CHANGED=0
RC=/opt/git/sigmond/hf-timestd/config/chrony-timestd-refclocks.conf
RC_CANON=/etc/chrony/conf.d/timestd-refclocks.conf
RC_LEGACY=/etc/chrony/conf.d/chrony-timestd-refclocks.conf
if [ -f "$RC" ] && [ ! -f "$RC_CANON" ]; then
    install -m 0644 "$RC" "$RC_CANON" \
        && CHANGED=1 && say "chrony FUSE/HPPS refclocks installed"
fi
# Retire the legacy duplicate whoever wrote it — an older image, an earlier
# run of this script, or a hand edit.  Same verb hf-timestd's installer uses.
if [ -e "$RC_LEGACY" ]; then
    mv -f "$RC_LEGACY" "$RC_LEGACY.legacy-disabled" \
        && CHANGED=1 \
        && say "retired duplicate refclock drop-in (chrony-timestd-refclocks.conf)"
fi

# ── 2. LAN stratum-1 NTP servers ────────────────────────────────────────────
# Wire what the operator trusts (lan-trust.toml [ntp]); OFFER what the scan
# finds.  A scan reply counts only from the probed address, as a server
# (mode 4), not unsynchronised (leap 3), stratum 1, and echoing in its origin
# timestamp the random transmit timestamp of our request -- so a host cannot
# answer for another, and a stray or replayed packet does not qualify.
LTS=/etc/chrony/conf.d/local-timeservers.conf
WIZ=/etc/chrony/conf.d/10-sigmond-ntp.conf
LTS_HAVE=$( [ -f "$LTS" ] && awk '$1 ~ /^(server|pool|peer)$/ {print $2}' "$LTS")
WIZ_HAVE=$( [ -f "$WIZ" ] && awk '$1 ~ /^(server|peer)$/ {print $2}' "$WIZ")
NTP_TRUSTED=$(lan_trust get-ntp 2>/dev/null)
# An existing local-timeservers.conf predates the record: its servers stay,
# trusted as they stand.  Say so once.
_untracked=""
for ip in $LTS_HAVE; do printf '%s\n' "$NTP_TRUSTED" | grep -qxF "$ip" || _untracked="$_untracked $ip"; done
if [ -n "$_untracked" ] && lan_noted_once ntp; then
    say "LAN NTP server(s)${_untracked} wired before the trust record existed - kept, as trusted.  To record: sudo sigmond-site-timing --trust-ntp <addr> --no-run (each)"
fi
_add=""
for ip in $NTP_TRUSTED; do printf '%s\n' "$LTS_HAVE" | grep -qxF "$ip" || _add="$_add $ip"; done
if [ -n "$_add" ]; then
    for ip in $_add; do echo "server $ip iburst minpoll 4 maxpoll 6"; done >> "$LTS"
    CHANGED=1; say "trusted LAN stratum-1 NTP wired:$_add"
fi
if [ -n "$SUBNET" ] && [ ! -f "$LTS" ]; then
    NTP1=$(python3 - "$SUBNET" <<'PYEOF'
import ipaddress, os, socket, sys, concurrent.futures
net = ipaddress.ip_network(sys.argv[1], strict=False)
def q(ip):
    ip = str(ip)
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(1)
        s.connect((ip, 123))                  # the kernel drops datagrams from any other source
        xmt = os.urandom(8)
        s.send(b'\x23' + 39 * b'\0' + xmt)   # v4 client; transmit timestamp at 40..47
        d, src = s.recvfrom(512); s.close()
    except Exception:
        return None
    if src[0] != ip or len(d) < 48: return None
    if d[0] & 7 != 4 or d[0] >> 6 == 3 or d[1] != 1: return None
    if d[24:32] != xmt: return None           # origin timestamp must echo our transmit
    refid = d[12:16].decode('ascii', 'replace').strip('\0').strip()
    refid = ''.join(c for c in refid if c.isalnum()) or '?'
    return '%s %s' % (ip, refid)
if net.num_addresses > 1024:
    # never report 'none found' for a network that was not looked at
    print(f"site LAN {net} too large to scan ({net.num_addresses} addresses) - not scanned", file=sys.stderr)
if net.num_addresses <= 1024:
    with concurrent.futures.ThreadPoolExecutor(64) as ex:
        for r in ex.map(q, net.hosts()):
            if r: print(r)
PYEOF
)
    while read -r ip refid; do
        [ -n "$ip" ] || continue
        printf '%s\n' "$WIZ_HAVE" | grep -qxF "$ip" && continue    # the operator named it already
        say "LAN stratum-1 NTP OFFER: $ip (stratum 1, refid $refid) - not wired.  To use it: sudo sigmond-site-timing --trust-ntp $ip"
    done <<EOF
$NTP1
EOF
    [ -z "$NTP1" ] && say "no local stratum-1 NTP found - public pool only"
fi
[ "$CHANGED" = 1 ] && systemctl restart chrony 2>/dev/null

# ── 2b. declare those LAN stratum-1 servers to hf-timestd as T4 peers ────────
# Chrony using a LAN stratum-1 is not T4: hf-timestd builds its T4 probe ONLY
# from [timing.authority_manager.t4] peers.  Step 2 wired chrony and nothing
# else, so AC0G-ND sat at T3 with 192.168.8.144 selected in chrony (±128 µs)
# from 2026-10-04 until T4 was declared by hand on 2026-10-05.  Read the
# servers from local-timeservers.conf -- whether step 2 wrote it just now or a
# site-restore replayed it -- and ADD any missing one; never remove an
# operator's peer.  The authority runner lives in timestd-authority-manager.
# ⛔ Declare only a server chrony ITSELF vouches for.  Step 2 accepts any
# host whose reply carries stratum 1; T4 outranks T3, so an unvetted
# responder (a router claiming stratum 1, an unsynchronised box) would
# become the authority (v3.68 review round 2).  Required, per server:
# chrony shows it selected or combined (^* / ^+) at stratum 1, leap Normal,
# and a real reference id (not LOCL/INIT).  A server that fails is logged
# and left for a later run -- chrony needs minutes to select a new source.
# Opt-out: [timing.authority_manager.t4] auto_declare = false, or an
# explicit peers = [] (both mean "the operator decides T4 here").
# A server the operator NAMED counts too: the v3.84 wizard writes its answer
# to 10-sigmond-ntp.conf, which chrony used and 2b never read, so a named LAN
# timeserver (South Pole's, or one the subnet scan cannot reach) never became
# T4.  Its `server`/`peer` lines only -- `pool` there is the public pool.  A
# host name resolves to an address, and that ADDRESS -- the one chrony's row
# was vetted under -- is what hf-timestd gets: a name it resolved again later
# could reach a machine nobody checked.  The vetting is the same for both files.
LTS=/etc/chrony/conf.d/local-timeservers.conf
WIZ=/etc/chrony/conf.d/10-sigmond-ntp.conf
if [ -f "$CFG" ] && { [ -f "$LTS" ] || [ -f "$WIZ" ]; }; then
    T4OK=""
    T4CAND=$( { [ -f "$LTS" ] && awk '$1 ~ /^(server|pool|peer)$/ {print $2}' "$LTS"
                [ -f "$WIZ" ] && awk '$1 ~ /^(server|peer)$/ {print $2}' "$WIZ"; } | awk '!seen[$0]++')
    # ⛔ Judge chrony AFTER it settles.  This step runs right after chrony
    # restarts (a boot, `sigmond-setup --ntp`), when the LAN server still
    # shows `^?` -- not yet selected, stratum 0, leap ?, refid ? -- and the
    # one-shot judgement logged "NOT declared" and nothing reran it: N8UR
    # needed a manual rerun (2026-11-14); SIGMA sat on T2 for days with
    # `^* 192.168.1.80` stratum 1.  So: a server that is merely UNSELECTED
    # is waited for (bounded); one that is clearly disqualified (stratum
    # above 1, leap alarm, LOCL/INIT, falseticker, absent) is judged at once.
    # Only the timing of the judgement changed -- the rules are the same.
    T4_WAIT_S=${SITE_TIMING_T4_WAIT_S:-180}
    T4_POLL_S=${SITE_TIMING_T4_POLL_S:-10}
    T4_RETRY_AFTER=${SITE_TIMING_T4_RETRY_AFTER:-10min}
    T4_RETRY_CMD=${SITE_TIMING_T4_RETRY_CMD:-/usr/local/sbin/sigmond-site-timing}
    T4_RETRY_UNIT=sigmond-site-timing-retry
    t4_probe() {   # chrony's view of server $1 -> T4_ADDR T4_ST T4_STRATUM T4_LEAP T4_REFID
        local ip=$1 nd src
        T4_ADDR=$ip
        [[ "$ip" =~ ^[0-9.]+$|: ]] || T4_ADDR=$(getent ahostsv4 "$ip" 2>/dev/null | awk 'NR==1 {print $1}')
        src=$(chronyc -n sources 2>/dev/null); T4_SRC_RC=$?
        read -r T4_ST T4_STRATUM <<<"$(printf '%s\n' "$src" | awk -v ip="${T4_ADDR:-$ip}" '$2 == ip {print $1, $3; exit}')"
        nd=$(chronyc -n ntpdata "${T4_ADDR:-$ip}" 2>/dev/null)
        T4_LEAP=$(printf '%s\n' "$nd" | sed -n 's/^Leap status *: *//p' | head -1)
        T4_REFID=$(printf '%s\n' "$nd" | sed -n 's/^Reference ID *: *[0-9A-Fa-f]* *(\(.*\)).*/\1/p' | head -1)
    }
    t4_verdict() {   # after t4_probe: OK (declare), WAIT (merely unselected), NO (disqualified)
        if [[ "${T4_ST:-}" == "^*" || "${T4_ST:-}" == "^+" ]] && [ "${T4_STRATUM:-}" = 1 ] \
           && [ "$T4_LEAP" = Normal ] && [ -n "$T4_REFID" ] && [ "$T4_REFID" != LOCL ] && [ "$T4_REFID" != INIT ]; then
            echo OK; return
        fi
        # chronyc not answering yet (chrony still starting): settling
        if [ "$T4_SRC_RC" != 0 ]; then echo WAIT; return; fi
        if [ "${T4_ST:-}" = "^?" ] && [[ "${T4_STRATUM:-0}" == [01] ]] \
           && { [ -z "$T4_LEAP" ] || [ "$T4_LEAP" = Normal ]; } \
           && [ "$T4_REFID" != LOCL ] && [ "$T4_REFID" != INIT ]; then
            echo WAIT; return
        fi
        echo NO
    }
    t4_any_waiting() { local c; for c in $T4CAND; do t4_probe "$c"; [ "$(t4_verdict)" = WAIT ] && return 0; done; return 1; }
    if t4_any_waiting && [ "$T4_WAIT_S" -gt 0 ] 2>/dev/null; then
        T4_T0=$SECONDS
        say "LAN server(s) not yet selected by chrony - waiting up to ${T4_WAIT_S}s (polling every ${T4_POLL_S}s) before judging T4"
        while [ $((SECONDS - T4_T0)) -lt "$T4_WAIT_S" ]; do
            sleep "$T4_POLL_S"
            t4_any_waiting || { say "chrony settled after $((SECONDS - T4_T0))s - judging T4 now"; T4_T0=; break; }
        done
        [ -n "$T4_T0" ] && say "chrony still had not selected the LAN server(s) after $((SECONDS - T4_T0))s - gave up waiting"
    fi
    T4_RETRY_NOTE=""
    t4_arm_retry() {   # ONE bounded retry, never stacked; the retry itself never re-arms
        [ -n "$T4_RETRY_NOTE" ] && return
        if [ -n "${SITE_TIMING_NO_RETRY:-}" ]; then
            T4_RETRY_NOTE="this was the retry; rerun: sudo $T4_RETRY_CMD"
        elif systemctl is-active --quiet "$T4_RETRY_UNIT.timer" "$T4_RETRY_UNIT.service" 2>/dev/null; then
            T4_RETRY_NOTE="a retry is already pending ($T4_RETRY_UNIT)"
        elif systemd-run --quiet --on-active="$T4_RETRY_AFTER" --unit="$T4_RETRY_UNIT" \
                 --setenv=SITE_TIMING_NO_RETRY=1 "$T4_RETRY_CMD" >/dev/null 2>&1; then
            T4_RETRY_NOTE="will retry once in $T4_RETRY_AFTER ($T4_RETRY_UNIT)"
        else
            T4_RETRY_NOTE="could not schedule a retry; rerun: sudo $T4_RETRY_CMD"
        fi
    }
    for ip in $T4CAND; do
        t4_probe "$ip"; v=$(t4_verdict); addr=$T4_ADDR; st=$T4_ST; stratum=$T4_STRATUM; leap=$T4_LEAP; refid=$T4_REFID
        if [ "$v" = OK ]; then
            T4OK="$T4OK ${addr:-$ip}"
        else
            if [ "$v" = WAIT ]; then t4_arm_retry; note=$T4_RETRY_NOTE
            else note="rerun after fixing: sudo $T4_RETRY_CMD"; fi
            say "LAN server $ip NOT declared as T4 (chrony ${st:-absent}, stratum ${stratum:-?}, leap ${leap:-?}, refid ${refid:-?}) - $note"
        fi
    done
    if [ -n "$T4OK" ]; then
        T4ADD=$(python3 - "$CFG" $T4OK 2>&1 <<'PYEOF'
import re, sys, tomllib
cfg, servers = sys.argv[1], sys.argv[2:]
text = open(cfg).read()
t4 = tomllib.loads(text).get('timing', {}).get('authority_manager', {}).get('t4')
if t4 is not None and (t4.get('auto_declare') is False
                       or ('peers' in t4 and t4['peers'] == [])):
    sys.exit(0)                           # operator opted out
have = (t4 or {}).get('peers', []) or []
missing = [s for s in servers if s not in have]
if not missing:
    sys.exit(0)
peers = list(have) + missing
line = 'peers = [' + ', '.join('"%s"' % p for p in peers) + ']  # sigmond-site-timing'
hdr = re.search(r'^\[timing\.authority_manager\.t4\][ \t]*$', text, re.M)
if hdr is None:
    text = text.rstrip('\n') + '\n\n[timing.authority_manager.t4]\n' + line + '\n'
else:
    nxt = re.search(r'^\[', text[hdr.end():], re.M)
    end = hdr.end() + (nxt.start() if nxt else len(text) - hdr.end())
    body = text[hdr.end():end]
    if re.search(r'^peers\s*=', body, re.M):
        body = re.sub(r'^peers\s*=.*$', line, body, count=1, flags=re.M)
    else:
        body = '\n' + line + body
    text = text[:hdr.end()] + body + text[end:]
tomllib.loads(text)                       # never write a config that will not parse
open(cfg, 'w').write(text)
print('ADDED ' + ' '.join(missing))
PYEOF
)
        case "$T4ADD" in
            ADDED*) say "T4 peers declared to hf-timestd: ${T4ADD#ADDED } - restarting timestd-authority-manager"
                    systemctl try-restart timestd-authority-manager 2>/dev/null ;;
            "")     ;;
            *)      say "T4 declaration FAILED, config untouched: $(printf '%s' "$T4ADD" | tail -1)" ;;
        esac
    fi
fi

# ── 2.5 identity reconciliation (relocation support) ───────────────────────
# Stations may be staged at one site and deployed at another (rob
# 2026-08-04: build in Scranton, deploy elsewhere). `sigmond-setup
# --reconfigure` updates site-profile + re-renders the main configs, but
# three places keep their own copy of grid/lat/lon and previously skipped
# regeneration when the files existed. Reconcile them against the
# canonical site-profile grid whenever they drift.
CANON=$(python3 - <<'PYEOF'
import tomllib
try:
    sp = tomllib.load(open('/etc/sigmond/site-profile.toml','rb'))
    st = sp.get('station',{})
    g = (st.get('grid_square') or '').strip()
    if len(g) >= 4:
        # explicit coordinates (e.g. written by the GPSDO location
        # authority) beat the grid-square centre approximation
        lat, lon = st.get('latitude'), st.get('longitude')
        if not (isinstance(lat,(int,float)) and isinstance(lon,(int,float))):
            g6 = (g + 'mm')[:6].upper()
            lon = (ord(g6[0])-65)*20 - 180 + int(g6[2])*2 + (ord(g6[4])-65)*(2/24) + 1/24
            lat = (ord(g6[1])-65)*10 -  90 + int(g6[3])   + (ord(g6[5])-65)*(1/24) + 1/48
        print("%s %.7f %.7f" % (g, lat, lon))
except Exception:
    pass
PYEOF
)
if [ -n "$CANON" ]; then
    set -- $CANON; G="$1"; LAT="$2"; LON="$3"
    # hf-timestd [station] — grid OR precise-coordinate drift
    if [ -f "$CFG" ] && { ! grep -q "grid_square = \"$G\"" "$CFG" || ! grep -q "latitude = $LAT" "$CFG"; }; then
        sed -i -e "s|^grid_square = .*|grid_square = \"$G\"|" \
               -e "s|^latitude = .*|latitude = $LAT|" \
               -e "s|^longitude = .*|longitude = $LON|" "$CFG" \
            && say "relocation: hf-timestd [station] -> $G ($LAT, $LON)"
    fi
    # metrology channel envs: regenerate on grid drift
    if [ -d /etc/hf-timestd/metrology-channels ] && \
       { ! grep -q "GRID_SQUARE=$G" /etc/hf-timestd/metrology-channels/*.env 2>/dev/null || \
         ! grep -q "LATITUDE=$LAT" /etc/hf-timestd/metrology-channels/*.env 2>/dev/null; }; then
        rm -rf /etc/hf-timestd/metrology-channels
        say "relocation: metrology channel envs stale — regenerating for $G"
        RESTART_METROLOGY=1
    fi
    # mag-recorder
    MAGCFG=/etc/mag-recorder/mag-recorder-config.toml
    if [ -f "$MAGCFG" ] && { ! grep -q "grid_square      = \"$G\"" "$MAGCFG" || ! grep -q "latitude         = $LAT" "$MAGCFG"; }; then
        sed -i -e "s|^grid_square      = .*|grid_square      = \"$G\"|" \
               -e "s|^latitude         = .*|latitude         = $LAT|" \
               -e "s|^longitude        = .*|longitude        = $LON|" "$MAGCFG" \
            && systemctl try-restart mag-recorder 2>/dev/null \
            && say "relocation: mag-recorder -> $G"
    fi
fi

# ── 3. metrology channel instances ──────────────────────────────────────────
# env files from [station] (populated by sigmond config render) + one
# timestd-metrology@ instance per channel. WWV/WWVH set only — CHU is off
# the air; upstream install.sh still lists it (flagged to mjh).
MC=/etc/hf-timestd/metrology-channels
# ⛔ GENERATE WHENEVER THE CONFIG EXISTS — not only when $MC is absent.
#
# This used to be `[ -f "$CFG" ] && [ ! -d "$MC" ]`, which is one-shot in both
# directions and cost WB6CXC-7 its entire timing chain:
#   * $CFG did not exist when the wizard ran this at 22:47:39 (hf-timestd was
#     installed later, at 23:28), so step 3 skipped -- with NO else branch, so
#     it said nothing at all.  That silence is what hid it for a day.
#   * once $MC does exist, the gate is false forever, so nothing ever
#     regenerates the env files when the station's identity changes.
# The station ran with zero timestd-metrology@ instances while
# timestd-metrology.target still reported "active" -- a target that pulls in
# nothing reaches active instantly, so every surface read green.
#
# Now: generate when $CFG exists, write each env file only if its content
# actually changed, and SAY which branch was taken either way.
if [ -f "$CFG" ]; then
    GEN=$(python3 - "$CFG" "$MC" <<'PYEOF'
import sys, tomllib, os
cfg, mc = sys.argv[1], sys.argv[2]
c = tomllib.load(open(cfg, 'rb'))
s = c.get('station', {})

# ⚡ PSWS IDENTITY DOES NOT GATE RECORDING.  rob, 2026-10-02: "metrology
# doesn't need PSWS info to record, only to upload."  The old guard was
# `if not s.get('callsign') or not s.get('id')`, where `id` is the PSWS
# station id -- so a station with no PSWS registration recorded NOTHING,
# silently, and the science was lost rather than merely un-uploaded.
# Only the callsign is structural (it names the channels); the PSWS ids are
# written when known and left empty when not.
def _clean(v):
    """Empty for a value that is really an unfilled template placeholder.

    `<YOUR_STATION_ID>` is a non-empty string, so the old guard let it
    through and it was baked verbatim into all six env files -- and nothing
    ever regenerated them, so the station would have uploaded under a literal
    placeholder forever.
    """
    v = str(v or '').strip()
    return '' if (v.startswith('<') and v.endswith('>')) else v

if not _clean(s.get('callsign')):
    print("skip-callsign"); raise SystemExit
r = c.get('recorder', {})
aroot = "/dev/shm/timestd/raw_buffer" if r.get('tiered_storage', False) else "/var/lib/timestd/raw_buffer"
os.makedirs(mc, exist_ok=True)
wrote = 0
for name, hz in [("SHARED_2500",2500000),("SHARED_5000",5000000),
                 ("SHARED_10000",10000000),("SHARED_15000",15000000),
                 ("WWV_20000",20000000),("WWV_25000",25000000)]:
    body = (
"""# Auto-generated by sigmond-site-timing
# Channel: %s
FREQUENCY_HZ=%d
CALLSIGN=%s
GRID_SQUARE=%s
STATION_ID=%s
INSTRUMENT_ID=%s
LATITUDE=%s
LONGITUDE=%s
DATA_ROOT=/var/lib/timestd
ARCHIVE_ROOT=%s
""" % (name, hz, _clean(s.get('callsign')), _clean(s.get('grid_square')),
       _clean(s.get('id')), _clean(s.get('instrument_id')),
       _clean(s.get('latitude')), _clean(s.get('longitude')), aroot))
    # Content-compare, so re-running is free AND a later identity change
    # (the PSWS id arriving after registration) actually propagates.  The
    # old code keyed regeneration on GRID_SQUARE/LATITUDE drift only, so a
    # station id could never update once written.
    p = os.path.join(mc, name + ".env")
    try:
        if open(p).read() == body:
            continue
    except OSError:
        pass
    open(p, "w").write(body)
    wrote += 1
print("ok" if wrote else "unchanged")
PYEOF
)
    case "$GEN" in
        ok)
            chown -R timestd:timestd "$MC" 2>/dev/null
            say "metrology channel env files generated (6 x WWV/WWVH)"
            if ! grep -qs '^STATION_ID=.' "$MC"/SHARED_2500.env; then
                say "  note: no PSWS station id yet — channels RECORD now;"
                say "  set [psws] in /etc/sigmond/site-profile.toml and re-run"
                say "  this script to enable upload. Recording does not wait."
            fi
            ;;
        unchanged)
            say "metrology channel env files already current (6 x WWV/WWVH)"
            ;;
        skip-callsign)
            say "⚠ metrology channels SKIPPED — no callsign in $CFG."
            say "  The station is not personalized; nothing can be recorded."
            ;;
        *)
            say "⚠ metrology channel generation returned '$GEN' — channels may be missing"
            ;;
    esac
else
    # NEVER skip silently.  The absence of this line is what let WB6CXC-7 run
    # for a day with no metrology at all and nothing anywhere saying so.
    say "⚠ metrology channels SKIPPED — $CFG absent (hf-timestd not configured"
    say "  yet).  Re-run this script after bring-up installs it:"
    say "    sudo /usr/local/sbin/sigmond-site-timing"
fi
if [ -d "$MC" ]; then
    for f in "$MC"/*.env; do
        [ -f "$f" ] || continue
        if [ "${RESTART_METROLOGY:-0}" = 1 ]; then
            systemctl restart "timestd-metrology@$(basename "$f" .env)" 2>/dev/null
            systemctl enable "timestd-metrology@$(basename "$f" .env)" 2>/dev/null
        else
            systemctl enable --now "timestd-metrology@$(basename "$f" .env)" 2>/dev/null
        fi
    done
    [ "${RESTART_METROLOGY:-0}" = 1 ] && systemctl try-restart timestd-fusion 2>/dev/null
fi

# ── 4. local GNSS stream (UBX or RTCM3) → [gnss_vtec] ───────────────────────
# hamsci-physics-vtec reads either: u-blox UBX (sync b5 62) or RTCM3 (preamble
# 0xD3, MSM/1004 -- the Quectel LG290P at AC0G-ND).  Probing for UBX alone left
# ND's VTEC off on every flash.
# The stream is wired only from the trust record (lan-trust.toml [gnss]); a
# stream the scan finds is OFFERED.  A host already in [gnss_vtec] stays.
# VTEC is wired when [gnss_vtec] is enabled and names a real host OR a real
# device.  A USB receiver (N8UR) keeps a placeholder host beside its device;
# such a station is never scanned and never rewritten.
GCFG=${GNSS_VTEC_TOML:-/etc/hamsci-physics/gnss-vtec.toml}
PHYSICS_DIR=/opt/git/sigmond/hamsci-physics
GNSS_TRUSTED=$(lan_trust get-gnss 2>/dev/null)
# gnss_state FILE prints "<state> <host>" for FILE's [gnss_vtec]; state is
# wired-host, wired-device, off (the operator disabled a real host or device:
# theirs to turn on) or none (absent or placeholders only: the trust record
# may fill it).
gnss_state() {
    python3 -c '
import sys, tomllib
try:
    g = tomllib.load(open(sys.argv[1], "rb")).get("gnss_vtec", {})
except Exception:
    g = {}
def real(v):
    v = str(v or "").strip()
    return v if v and "<" not in v and ">" not in v else ""
h, d = real(g.get("host")), real(g.get("device"))
if not (d or h): print("none")
elif not g.get("enabled"): print("off")
elif d: print("wired-device", h)
else: print("wired-host", h)' "$1" 2>/dev/null
}
# v3.96 moved VTEC from hf-timestd's timestd-vtec.service to
# hamsci-physics-vtec.service, and smd align carries the move out.  Align
# holds it on some stations (--no-restart, a locally_managed owner,
# hamsci-physics stopped or disabled).  There the old unit still reads the
# receiver, and a serial port tolerates one reader: while timestd-vtec is
# enabled or running, this step neither wires the new file from nothing nor
# starts the new unit.  A failed timestd-vtec that is also disabled holds
# nothing: nothing starts it again (sigmond.unit_moves.in_service, the rule
# align's moves use).
old_vtec_live() {
    case "$(systemctl is-enabled timestd-vtec.service 2>/dev/null)" in enabled*) return 0 ;; esac
    case "$(systemctl is-active timestd-vtec.service 2>/dev/null)" in
        active|activating|reloading) return 0 ;;
    esac
    # a wants-link left behind by a unit file that went with its checkout
    ls /etc/systemd/system/*.wants/timestd-vtec.service >/dev/null 2>&1
}
GSTATE=none; _gh=""
if [ -f "$GCFG" ]; then
    read -r GSTATE _gh <<<"$(gnss_state "$GCFG")"
    GSTATE=${GSTATE:-none}
elif old_vtec_live; then
    GSTATE=pending
elif [ -f "$CFG" ] && [ "$(gnss_state "$CFG" | cut -d' ' -f1)" = off ]; then
    # The move's adoption copies only an enabled [gnss_vtec]; an operator's
    # "off" in the legacy file must not be undone by the trust record.
    GSTATE=legacy-off
fi
if [ "$GSTATE" = wired-host ] && [ -n "$_gh" ] && [ "$_gh" != "$GNSS_TRUSTED" ] && lan_noted_once gnss; then
    say "GNSS stream host $_gh was set before the trust record existed - kept, as trusted.  To record: sudo sigmond-site-timing --trust-gnss <addr> --no-run"
fi
if [ "$GSTATE" = off ] && lan_noted_once gnssoff; then
    say "gnss-vtec kept off by the operator ($GCFG)"
fi
if [ "$GSTATE" = legacy-off ] && lan_noted_once gnssoff; then
    say "gnss-vtec kept off by the operator ($CFG [gnss_vtec])"
fi
if [ "$GSTATE" = pending ]; then
    say "gnss-vtec not wired: timestd-vtec.service still runs, so its move to"
    say "  hamsci-physics-vtec is pending.  smd align --apply finishes it."
fi
GHOST=""
if [ "$GSTATE" = none ] && [ -n "$GNSS_TRUSTED" ]; then
    GHOST=$GNSS_TRUSTED
elif [ "$GSTATE" = none ] && [ -n "$SUBNET" ]; then
    GFOUND=$(python3 - "$SUBNET" <<'PYEOF'
import ipaddress, socket, sys, concurrent.futures
net = ipaddress.ip_network(sys.argv[1], strict=False)
def probe(ip):
    try:
        s = socket.create_connection((str(ip), 9000), timeout=1); s.settimeout(2)
        d = b""
        try:
            while len(d) < 2048:
                b = s.recv(2048)
                if not b: break      # peer closed: recv returns b'' forever
                d += b
        except socket.timeout: pass
        s.close()
        if b"\xb5\x62" in d: return str(ip) + " UBX"
        # RTCM3: preamble D3, 6 reserved bits zero, 10-bit length.  Require
        # two frames back to back so a stray 0xD3 byte cannot qualify.
        for i in range(len(d) - 3):
            if d[i] == 0xD3 and d[i + 1] & 0xFC == 0:
                n = ((d[i + 1] & 0x03) << 8) | d[i + 2]
                j = i + 3 + n + 3
                if j + 1 < len(d) and d[j] == 0xD3 and d[j + 1] & 0xFC == 0:
                    return str(ip) + " RTCM3"
    except Exception: pass
if net.num_addresses > 1024:
    # never report 'none found' for a network that was not looked at
    print(f"site LAN {net} too large to scan ({net.num_addresses} addresses) - not scanned", file=sys.stderr)
if net.num_addresses <= 1024:
    with concurrent.futures.ThreadPoolExecutor(64) as ex:
        for r in ex.map(probe, net.hosts()):
            if r: print(r); break
PYEOF
)
    if [ -n "$GFOUND" ]; then
        read -r _gip _gproto <<<"$GFOUND"
        say "GNSS stream OFFER: $_gip:9000 ($_gproto) - not wired.  To use it: sudo sigmond-site-timing --trust-gnss $_gip"
    else
        say "no local GNSS stream (UBX/RTCM3) on :9000 - vtec stays off"
    fi
fi
if [ -n "$GHOST" ] && [ ! -d "$PHYSICS_DIR" ]; then
    say "GNSS host trusted, but hamsci-physics is not installed - VTEC stays off"
elif [ -n "$GHOST" ]; then
    mkdir -p "$(dirname "$GCFG")"
    python3 - "$GCFG" "$GHOST" <<'PYEOF'
import os, re, sys
p, host = sys.argv[1], sys.argv[2]
table = (
    "[gnss_vtec]\n"
    "enabled = true  # wired by sigmond-site-timing from lan-trust.toml\n"
    'host = "%s"\n'
    "port = 9000\n"
    'protocol = "auto"\n'
    'ephemeris_dir = "data/brdc"\n'
    "save_csv = false\n" % host)
if os.path.exists(p):
    # keep any other table (a [station], say); replace only [gnss_vtec]
    s = open(p).read()
    pat = re.compile(r"^\[gnss_vtec\][^\n]*\n.*?(?=^\[|\Z)", re.S | re.M)
    s = pat.sub(lambda m: table + "\n", s, count=1) if pat.search(s) else s.rstrip("\n") + "\n\n" + table
else:
    s = table
tmp = p + ".tmp-site-timing"
with open(tmp, "w") as f:
    f.write(s)
os.chmod(tmp, 0o644)
os.replace(tmp, p)
PYEOF
    say "trusted GNSS stream wired: $GHOST:9000 - gnss_vtec enabled"
    if old_vtec_live; then
        say "  hamsci-physics-vtec not restarted: timestd-vtec.service still runs (move pending)"
    else
        # restart, not try-restart: the unit may be stopped (its condition was unmet)
        systemctl restart hamsci-physics-vtec 2>/dev/null
    fi
fi

# ── 4.5 meteor-scatter (MSK144) — dasi2 appliance policy: ON ────────────────
# The catalog marks meteor-scatter optional, so bringup neither configures
# it nor mints its instance; and `instance add` seeds no radiod/channel
# config at all (three mjh flags: catalog policy, _REPORTER_KEYED, a
# non-interactive meteor config path). Generate the working config here —
# identical to the hand-validated 2026-07-29 B4 deployment.
if [ -d /opt/git/sigmond/meteor-scatter ] && command -v smd >/dev/null 2>&1; then
    REPORTER=$(python3 - <<'PYEOF'
import tomllib
try:
    c = tomllib.load(open('/etc/sigmond/site-profile.toml','rb'))
    print(c.get('reporters',{}).get('reporter_id') or c.get('station',{}).get('callsign') or '')
except Exception: print('')
PYEOF
)
    RADID=$(ls /etc/radio/radiod@*.conf 2>/dev/null | head -1 | sed 's/.*radiod@\(.*\)\.conf/\1/')
    if [ -n "$REPORTER" ] && [ -n "$RADID" ]; then
        # smd owns the spellings of a reporter id.  The instance key names
        # both the file and the unit (AC0G-B4.toml, meteor-scatter@AC0G-B4),
        # as `instance add` names them; `canonical --systemd` prints it.
        # Never systemd-escape: it turns '-' into \x2d, a unit nobody
        # enabled.  The display form (AC0G/B4) is the storage form (AC0G=B4)
        # with '=' turned back into '/'.
        if INST=$(smd admin instance canonical "$REPORTER" 2>/dev/null) \
           && UNIT_INST=$(smd admin instance canonical --systemd "$REPORTER" 2>/dev/null) \
           && [ -n "$INST" ] && [ -n "$UNIT_INST" ]; then
            SHOWN=$(printf '%s' "$INST" | tr '=' '/')
            MCONF="/etc/meteor-scatter/$UNIT_INST.toml"
            # Before v3.95 this step wrote the storage form (AC0G=B4.toml)
            # beside the key-named instance: a phantom instance that failed
            # align's uploader routing (B4, SIGMA).  Move our own aside.
            STRAY="/etc/meteor-scatter/$INST.toml"
            if [ "$STRAY" != "$MCONF" ] && [ -f "$STRAY" ] \
               && grep -q '^# Auto-generated by sigmond-site-timing' "$STRAY"; then
                mkdir -p /var/lib/sigmond/instance-rekey-backup \
                    && mv -f "$STRAY" /var/lib/sigmond/instance-rekey-backup/ \
                    && say "moved the stray $STRAY to /var/lib/sigmond/instance-rekey-backup/"
            fi
            if ! grep -q '\[\[radiod\]\]' "$MCONF" 2>/dev/null; then
                smd install --components meteor-scatter --yes >/dev/null 2>&1
                smd admin instance add --force meteor-scatter "$REPORTER" >/dev/null 2>&1
                python3 - "$MCONF" "$SHOWN" "$RADID" <<'PYEOF'
import sys, tomllib
p, reporter, radid = sys.argv[1], sys.argv[2], sys.argv[3]
sp = tomllib.load(open('/etc/sigmond/site-profile.toml','rb'))
st = sp.get('station', {})
open(p, 'w').write("""# Per-instance config for meteor-scatter@%s
# Auto-generated by sigmond-site-timing (validated live on B4 2026-07-29)

[instance]
reporter_id = "%s"
sources = ["radiod:%s"]

[station]
callsign    = "%s"
grid_square = "%s"

[[radiod]]
status = "%s-status.local"

[radiod.msk144]
sample_rate   = 12000
preset        = "usb"
encoding      = "s16be"
tr_period_sec = 30
freqs_hz      = [
  28_145_000,
  50_260_000,
]
""" % (reporter, reporter, radid,
       st.get('callsign',''), st.get('grid_square',''), radid))
PYEOF
                systemctl enable --now "meteor-scatter@$UNIT_INST.service" 2>/dev/null \
                    && say "meteor-scatter@$SHOWN configured + started (MSK144 10m/6m)" \
                    || say "WARN: meteor-scatter@$SHOWN failed to start - check journal"
            fi
        else
            say "WARN: smd could not read reporter id '$REPORTER' (an invalid id, or an smd older than v3.72) - meteor-scatter not configured"
        fi
    fi
fi

# ── 4.7 ka9q-web ─────────────────────────────────────────────────────────────
# The sentinel-driven bringup can end with radiod running but NO ka9q-web
# unit written (unit-writer needs the radiod status name; the bringup
# re-install step didn't fire on the 2026-07-30 field greenfield — mjh
# flag). Ensure it here, after radiod exists.
if ls /etc/radio/radiod@*.conf >/dev/null 2>&1 && ! systemctl list-unit-files --no-legend 'ka9q-web*' 2>/dev/null | grep -q ka9q-web; then
    smd install --components ka9q-web --yes >/dev/null 2>&1
    systemctl enable --now ka9q-web 2>/dev/null \
        && say "ka9q-web installed + started (:8081)" \
        || say "WARN: ka9q-web install/start failed - check smd status"
fi

# ── 4.8 precision timing tiers (T5 GPSDO PPS / T6 BPSK PPS) ─────────────────
# The config template ships every tier above chrony DISABLED, so a fresh
# greenfield silently runs the offset judge at T4 (found on the 2026-08-05
# B4 v3.19 install). T5 is auto-detectable: gpsdo-monitor publishes
# per-device JSON under /run/gpsdo when an LBE-142x is present. T6 is not
# armed here: hf-timestd's setup-station arms it from a TS-1 on this host's
# USB (since 2026-09-17, behind the T6 acceptance battery), and step 4.9
# below arms it from a TS-1 the operator declared with `ts1 trust`.
if [ -f "$CFG" ]; then
    TCHANGED=$(python3 - "$CFG" <<'PYEOF'
import glob, json, re, shutil, sys, time, tomllib
cfg = sys.argv[1]
changed = []
s = open(cfg).read()

# T5: enable only for a GPSDO whose NMEA stream hf-timestd's T5 reader is
# built for — the LBE-1421/1423 (gpsdo-monitor's has_nmea_cdc models). The
# old test also fired on `d.get('health')`, which every monitored GPSDO has,
# so an LBE-mini (HID only, no CDC-NMEA) got lb1421_enabled = true and a T5
# that never lights (AC0G-ND 2026-09-25). Whether a mini's UBX NAV time can
# feed T5 is an open question for hf-timestd, not something to switch on here.
T5_NMEA_MODELS = ('lbe-1421', 'lbe-1423')
t5 = False
for p in glob.glob('/run/gpsdo/*.json'):
    if p.endswith('index.json'): continue
    try: d = json.load(open(p))
    except Exception: continue
    dev = d.get('device') if isinstance(d.get('device'), dict) else {}
    model = (dev.get('model') or d.get('model') or d.get('product') or '').lower()
    if model in T5_NMEA_MODELS:
        t5 = True; break
cur = tomllib.load(open(cfg, 'rb')).get('timing', {})
if t5 and not cur.get('lb1421_enabled'):
    if re.search(r'(?m)^lb1421_enabled\s*=', s):
        s = re.sub(r'(?m)^lb1421_enabled\s*=.*$', 'lb1421_enabled = true', s, count=1)
    else:
        s = re.sub(r'(?m)^(\[timing\]\n)', r'\1lb1421_enabled = true\n', s, count=1)
    changed.append('T5')

# T6: see step 4.9.

if changed:
    shutil.copy2(cfg, cfg + '.bak-tiers-' + time.strftime('%Y%m%d-%H%M%S'))
    open(cfg, 'w').write(s)
print(' '.join(changed))
PYEOF
)
    if [ -n "$TCHANGED" ]; then
        say "precision timing tiers enabled: $TCHANGED - restarting timestd-core-recorder, timestd-authority-manager"
        systemctl try-restart timestd-core-recorder timestd-authority-manager 2>/dev/null
    fi
fi

# ── 4.9 T6 from a TS-1 shared through a splitter ───────────────────────────
# One TS-1 can feed several RX888s through a splitter, but its USB console
# plugs into one machine.  At AC0G's site (2026-11-14) the USB sits on B4, so
# SIGMA's bring-up found no TS-1 and left T6 off although its RX888 hears the
# pilot.
#
# ⛔ The operator's declaration is the authority; a LAN advertisement is only a
# cross-check.  An advertisement is unauthenticated (host and board id are
# self-asserted), it may never cross a NAT (B4's decoder VM sits behind its
# Proxmox host), and hardware appearing is never an instruction (Rob,
# 2026-09-01).  So the operator declares the TS-1 once, with the TX frequency
# `ts1 probe` reports on the host that holds its USB:
#     sudo ts1 trust <host> <board_id> <tx_hz>     (-> /etc/sigmond/ts1-trust.toml)
# which records host, board id, TX, this station's ADC rate and the folded
# frequency_hz.  This step arms T6 from that record alone; T6's own
# acquisition and acceptance battery decide whether the pilot is really here,
# and each station still learns its own chain delay.
#
# Rules, each logged as ONE line:
#   - T6 already enabled (an operator, or setup-station's local probe):
#     untouched, never re-armed or re-tuned from here.
#   - A TS-1 on this host's own USB: its probe decides; nothing done here.
#   - No trust record: nothing armed.  If exactly one advertisement is
#     visible, the line names the `ts1 trust` command for it (an OFFER).
#   - The record must be well formed and self-consistent, and this station's
#     ADC rate (the `samprate` line of radiod's [rx888] section, never the
#     [global] channel rate) must still be the one it was recorded at.
#   - Advertisements claiming the trusted host or board id, if any are visible:
#     more than one, a host/board/TX that differs from the record, a non-PPS
#     mode, or a timestamp in the future or stale -> refused; not GPS-locked
#     -> not armed this run.  None visible -> armed, logged as not cross-checked.
#     A changed source address is warned about.
# Every advertised value is checked against a strict pattern or parsed as a
# range-checked int before it reaches the journal; the config receives only
# the record's values, and the edited config must read back equal to the
# original apart from [timing.t6_pps] enabled/frequency_hz, or nothing is written.
# Restart: core-recorder (creates the T6 channel, runs the detector) and fusion
# (the authority runner reads t6_pps).  Never metrology: it reads authority
# state, and stopping it kills T6 (N8UR 2026-11-14).
if [ -f "$CFG" ]; then
    T6LAN=$(SIGMOND_LIB="${SIGMOND_LIB:-${_ST_LIB:-/opt/git/sigmond/sigmond/lib}}" python3 - "$CFG" \
        "${TS1_LOCAL_GLOB:-/dev/serial/by-id/usb-Adafruit_Trinket_M0_*}" \
        "${TS1_BROWSE_CMD:-${_ST_TS1_ADVERTISE:-/usr/local/sbin/sigmond-ts1-advertise}}" \
        "${RADIOD_CONF_GLOB:-/etc/radio/radiod@*.conf}" "${TS1_LAN_MAX_AGE_S:-1800}" \
        "${TS1_TRUST_FILE:-/etc/sigmond/ts1-trust.toml}" 2>&1 <<'PYEOF'
import copy, glob, ipaddress, json, os, re, shutil, subprocess, sys, time, tomllib
cfg, local_glob, browse_cmd, radiod_glob, max_age, trust_file = sys.argv[1:7]
# The same patterns sigmond-ts1-advertise holds a trust record to.
HOST_RE = re.compile(r'[A-Za-z0-9][A-Za-z0-9.-]{0,62}')
BOARD_RE = re.compile(r'[0-9A-Za-z]{1,32}')
def ok_host(v): return isinstance(v, str) and HOST_RE.fullmatch(v) is not None
def ok_board(v): return isinstance(v, str) and BOARD_RE.fullmatch(v) is not None
def ok_ip(v):
    try:
        ipaddress.ip_address(v); return isinstance(v, str)
    except (ValueError, TypeError):
        return False
def safe(v):
    """For the journal only: an unchecked LAN value, defanged and capped."""
    return re.sub(r'[^A-Za-z0-9.:_ -]', '?', str(v))[:40]
def show(r):
    return '[from %s host %s board %s tx_hz %s ts %s]' % (
        safe(','.join(map(str, r.get('addresses', []) or [r.get('address', '?')]))),
        safe(r.get('host')), safe(r.get('board_id')), safe(r.get('tx_hz')), safe(r.get('ts')))
def out(kind, msg):
    print(kind + ' ' + msg); sys.exit(0)
def int_in(v, lo, hi):
    if isinstance(v, bool):
        return None
    try:
        n = int(str(v).strip())
    except ValueError:
        return None
    return n if lo <= n <= hi else None
def fold(tx, adc):
    r = tx % adc
    return r if r * 2 <= adc else adc - r              # == ts1_channel.nyquist_alias_hz
text = open(cfg).read()
doc = tomllib.loads(text)
timing = doc.get('timing', {}) or {}
t6, l6 = timing.get('t6_pps'), timing.get('l6_pps')
sec = t6 if isinstance(t6, dict) else (l6 if isinstance(l6, dict) else None)
name = 't6_pps' if isinstance(t6, dict) else 'l6_pps'
if sec and sec.get('enabled'):
    out('SKIP', 'T6 already enabled ([timing.%s] frequency_hz = %s) - left as set; no shared TS-1 consulted'
        % (name, safe(sec.get('frequency_hz'))))
local = [p for p in glob.glob(local_glob) if os.path.exists(p)]
if local:
    out('SKIP', 'a TS-1 is on this host\'s own USB (%s) - its probe (setup-station) decides T6; nothing done here'
        % safe(local[0]))
if t6 is None and isinstance(l6, dict):
    out('REFUSED', 'config carries only the legacy [timing.l6_pps] section - rename it to [timing.t6_pps] and rerun; T6 not armed')

def browse():
    """Every distinct advertisement, or None when the LAN could not be read."""
    try:
        r = subprocess.run([browse_cmd, '--browse'], capture_output=True, text=True, timeout=60)
        recs = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        recs = None
    if not isinstance(recs, list) or not all(isinstance(x, dict) for x in recs):
        return None
    return recs

trust = None
try:
    trust = tomllib.loads(open(trust_file).read()).get('trusted', {})
except FileNotFoundError:
    pass
except (OSError, ValueError) as e:
    out('REFUSED', 'trust record %s unreadable (%s) - T6 not armed' % (trust_file, safe(e)))
if trust is None:
    recs = browse() or []
    if len(recs) == 1 and ok_host(recs[0].get('host')) and ok_board(recs[0].get('board_id')) \
       and int_in(recs[0].get('tx_hz'), 1_000_000, 200_000_000):
        x = recs[0]
        out('OFFER', 'no TS-1 declared here; the LAN advertises board %s on %s, TX %s Hz %s. If this station\'s RX888 '
            'is fed from it, check TX with `ts1 probe` on %s, then: sudo ts1 trust %s %s <tx_hz> ; '
            'sudo /usr/local/sbin/sigmond-site-timing'
            % (x['board_id'], x['host'], int(x['tx_hz']), show(x), x['host'], x['host'], x['board_id']))
    out('NONE', 'no TS-1 declared here (%d advertised on the LAN) - T6 stays off; '
        'to share one: sudo ts1 trust <host> <board_id> <tx_hz>' % len(recs))

TKEYS = {'host', 'board_id', 'tx_hz', 'adc_hz', 'frequency_hz'}
if not (isinstance(trust, dict) and TKEYS <= set(trust) <= TKEYS | {'address'}
        and ok_host(trust['host']) and ok_board(trust['board_id'])
        and all(type(trust[k]) is int for k in ('tx_hz', 'adc_hz', 'frequency_hz'))
        and 1_000_000 <= trust['tx_hz'] <= 200_000_000 and 1_000_000 <= trust['adc_hz'] <= 1_000_000_000
        and ('address' not in trust or ok_ip(trust['address']))):
    out('REFUSED', 'trust record %s malformed (rerun: sudo ts1 trust <host> <board_id> <tx_hz>) - T6 not armed' % trust_file)
if trust['frequency_hz'] != fold(trust['tx_hz'], trust['adc_hz']):
    out('REFUSED', 'trust record %s is inconsistent (frequency_hz is not the fold of tx_hz at adc_hz) - T6 not armed' % trust_file)
host, board, tx, alias = trust['host'], trust['board_id'], trust['tx_hz'], trust['frequency_hz']
src = 'the declared TS-1 board %s on %s' % (board, host)

confs = sorted(glob.glob(radiod_glob))
if not confs:
    out('REFUSED', 'no radiod config on this host (%s) - cannot read the ADC rate; T6 not armed' % radiod_glob)
sys.path.insert(0, os.environ['SIGMOND_LIB'])
try:
    from sigmond import sdr_map
except Exception as e:
    out('REFUSED', 'cannot read radiod rates without sigmond (%s) - T6 not armed' % safe(e))
rates = {}
for p in confs:
    t = open(p).read()
    hw = sdr_map._unquote(sdr_map._section_value(t, 'hardware', 'global')).lower() or 'rx888'
    if hw != 'rx888':
        out('REFUSED', '%s front end is %s, not an RX888 - T6 not armed' % (os.path.basename(p), safe(hw)))
    if not sdr_map._section_value(t, 'samprate', hw):
        out('REFUSED', 'no samprate line in [%s] of %s - cannot read the ADC rate; T6 not armed' % (hw, os.path.basename(p)))
    rate = int_in(sdr_map.conf_adc_samprate_hz(t) or 0, 1_000_000, 1_000_000_000)
    if rate is None:
        out('REFUSED', 'unreadable samprate in [%s] of %s - T6 not armed' % (hw, os.path.basename(p)))
    rates[os.path.basename(p)] = rate
if len(set(rates.values())) > 1:
    out('REFUSED', 'radiod configs disagree on the ADC rate (%s) - T6 not armed'
        % ', '.join('%s %d' % kv for kv in rates.items()))
adc = next(iter(rates.values()))
if adc != trust['adc_hz']:
    out('REFUSED', 'this station\'s ADC rate is %d sps, but %s was declared at %d sps - T6 not armed '
        '(re-declare: sudo ts1 trust %s %s %d)' % (adc, src, trust['adc_hz'], host, board, tx))
sec = sec or {}
edge = max(abs(int(sec.get('low_edge_hz', -25000))), abs(int(sec.get('high_edge_hz', 25000))))
if not edge < alias < adc // 2 - edge:
    out('REFUSED', 'TX %d Hz aliases to %d Hz at %d sps, outside (%d, %d) where the T6 channel fits - T6 not armed'
        % (tx, alias, adc, edge, adc // 2 - edge))

# The cross-check: an advertisement may object, never supply a value.
recs = browse()
if recs is None:
    check = 'not cross-checked (LAN not readable)'
else:
    mine = [r for r in recs if r.get('host') == host or r.get('board_id') == board]
    if not mine:
        check = 'not cross-checked (no advertisement visible)'
    else:
        shown = '; '.join(show(r) for r in mine[:4])
        if len(mine) > 1:
            out('REFUSED', '%d advertisements claim host %s or board %s: %s - T6 not armed' % (len(mine), host, board, shown))
        x = mine[0]
        v4 = [a for a in (x.get('addresses') or []) if ok_ip(a) and ':' not in a]
        if len(v4) > 1:
            out('REFUSED', 'the advertisement answers from several IPv4 addresses: %s - T6 not armed' % shown)
        if x.get('host') != host or x.get('board_id') != board or x.get('tx_hz') != str(tx):
            out('REFUSED', 'the advertisement contradicts %s (TX %d Hz): %s - T6 not armed' % (src, tx, shown))
        ts = int_in(x.get('ts', ''), 0, 2**40)
        if ts is None or ts - time.time() > 60 or time.time() - ts > int(max_age):
            out('REFUSED', 'the advertisement for %s is undated, in the future or stale: %s - T6 not armed' % (src, shown))
        mode = x.get('mode', '')
        if not isinstance(mode, str) or (mode and 'PPS' not in mode.upper()):
            out('REFUSED', 'the advertisement says %s is in mode %s, not a PPS mode - T6 not armed' % (src, safe(mode)))
        if x.get('gps_lock') != 'yes':
            out('WAIT', 'the advertisement says %s has no GPS lock - T6 not armed this run' % src)
        check = 'cross-checked against its advertisement (GPS locked)'
        if 'address' in trust and x.get('address') != trust['address']:
            check += '; WARNING: advertised from %s, declared at %s' % (
                x.get('address') if ok_ip(x.get('address')) else safe(x.get('address')), trust['address'])

# Every value below comes from the validated record or radiod's own config.
note = '# armed by sigmond-site-timing from the declared TS-1 board %s on %s, TX %d Hz at %d sps, %s' % (
    board, host, tx, adc, time.strftime('%Y-%m-%d %H:%M:%SZ', time.gmtime()))
hdr = re.search(r'^\[timing\.t6_pps\][ \t]*(#.*)?$', text, re.M)
if hdr is None:
    new = text.rstrip('\n') + '\n\n[timing.t6_pps]\n%s\nenabled = true\nfrequency_hz = %d\n' % (note, alias)
else:
    nxt = re.search(r'^\[', text[hdr.end():], re.M)
    end = hdr.end() + (nxt.start() if nxt else len(text) - hdr.end())
    body = text[hdr.end():end]
    body = re.sub(r'^enabled\s*=.*\n?', '', body, count=1, flags=re.M)
    if re.search(r'^frequency_hz\s*=', body, re.M):
        body = re.sub(r'^frequency_hz\s*=.*$', 'frequency_hz = %d' % alias, body, count=1, flags=re.M)
        ins = '%s\nenabled = true\n' % note
    else:
        ins = '%s\nenabled = true\nfrequency_hz = %d\n' % (note, alias)
    body = '\n' + ins + body.lstrip('\n')
    new = text[:hdr.end()] + body + text[end:]
# Read back: never write a config that will not parse, and never one that
# changed anything but [timing.t6_pps] enabled / frequency_hz.
try:
    after = tomllib.loads(new)
except ValueError as e:
    out('REFUSED', 'the edited config would not parse (%s) - config untouched' % safe(e))
want = copy.deepcopy(doc)
want.setdefault('timing', {}).setdefault('t6_pps', {}).update(enabled=True, frequency_hz=alias)
if after != want:
    out('REFUSED', 'the edited config changed more than [timing.t6_pps] enabled/frequency_hz - config untouched')
shutil.copy2(cfg, cfg + '.bak-t6-lan-' + time.strftime('%Y%m%d-%H%M%S'))
open(cfg, 'w').write(new)
out('ARMED', 'T6 armed from %s: frequency_hz = %d (TX %d Hz folded at %d sps); %s' % (src, alias, tx, adc, check))
PYEOF
)
    case "$T6LAN" in
        ARMED*)   say "${T6LAN#ARMED } - restarting timestd-core-recorder, timestd-authority-manager"
                  systemctl try-restart timestd-core-recorder timestd-authority-manager 2>/dev/null ;;
        OFFER*)   say "T6 OFFER, config untouched: ${T6LAN#OFFER }" ;;
        WAIT*)    say "T6 NOT armed this run: ${T6LAN#WAIT }" ;;
        SKIP*)    say "T6: ${T6LAN#SKIP }" ;;
        NONE*)    say "T6: ${T6LAN#NONE }" ;;
        REFUSED*) say "T6 NOT armed from the shared TS-1: ${T6LAN#REFUSED }" ;;
        *)        say "T6 shared-TS-1 step FAILED, config untouched: $(printf '%s' "$T6LAN" | tail -1 | tr -c '[:alnum:] .:_()=-\n' '?')" ;;
    esac
fi

# ── 5. full timing profile ──────────────────────────────────────────────────
timestd profile set full >/dev/null 2>&1 && say "timestd profile: full"

# ── 6. hs-uploader key ownership (sigmond#41 family) ────────────────────────
# minted key comes out root-owned -> hsupload gets Permission denied every
# SFTP tar cycle and silently falls back to FTP. Real fix belongs in
# sigmond's key mint; repair here until it lands.
id hsupload >/dev/null 2>&1 && chown -R hsupload:sigmond /etc/hs-uploader/keys 2>/dev/null
# one portal key serves every consumer (rob's directive): grape looks for
# /home/timestd/.ssh/id_rsa_psws and mag-recorder/status for keys/id_ed25519,
# but the wizard mints (and the portal registers) keys/id_ed25519_host —
# fan the registered key out to the expected paths (2026-08-05 B4 fix)
HK=/etc/hs-uploader/keys/id_ed25519_host
# ⛔ hsupload can write /etc/hs-uploader/keys, so root must not follow a link
# there either (security review, 2026-11-15).  Root reads the source only as
# a regular file, opened with O_NOFOLLOW, owned by root or hsupload; every
# copy is written by the account that owns its destination, through runuser.
st_read_key() {   # st_read_key <path> private|public: its bytes on stdout, or a reason on stderr
    python3 - "$1" "${2:-private}" <<'PYEOF'
import os, pwd, stat, sys
p, kind = sys.argv[1], sys.argv[2]
owners = {0}
try:
    owners.add(pwd.getpwnam('hsupload').pw_uid)
except KeyError:
    pass
try:
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except OSError as e:
    sys.exit('%s: not opened without following links (%s)' % (p, e.strerror))
st = os.fstat(fd)
if not stat.S_ISREG(st.st_mode):
    sys.exit('%s: not a regular file' % p)
if st.st_uid not in owners:
    sys.exit('%s: owned by uid %d, not root or hsupload' % (p, st.st_uid))
# A hard link passes O_NOFOLLOW and the owner check.  Debian's
# fs.protected_hardlinks=1 already stops hsupload linking a file it cannot
# read; this is defence in depth.
if st.st_nlink != 1:
    sys.exit('%s: has %d hard links' % (p, st.st_nlink))
if st.st_size > 16384:
    sys.exit('%s: %d bytes, too large for a key' % (p, st.st_size))
with os.fdopen(fd, 'rb') as f:
    data = f.read(16385)
if kind == 'private':
    body = data.strip()
    ok = (body.startswith(b'-----BEGIN OPENSSH PRIVATE KEY-----\n')
          and body.endswith(b'\n-----END OPENSSH PRIVATE KEY-----')
          and body.count(b'-----BEGIN') == 1)
else:
    ok = data.startswith(b'ssh-') and data.rstrip(b'\n').count(b'\n') == 0
if not ok:
    sys.exit('%s: not an OpenSSH %s key' % (p, kind))
sys.stdout.buffer.write(data)
PYEOF
}
# st_write_as <user> <mode> <dest> < bytes: written as <user>, beside <dest>
# and renamed over it; refused when <dest> exists or is a link.
st_write_as() {
    runuser -u "$1" -- sh -c 'umask 077; [ ! -e "$2" ] && [ ! -L "$2" ] || exit 1
        cat > "$2.new" && chmod "$1" "$2.new" && mv -f "$2.new" "$2"' sh "$2" "$3" 2>/dev/null
}
if [ -L "$HK" ]; then
    say "PSWS key NOT fanned out: $HK is a symlink - refused"
elif [ -f "$HK" ]; then
    KTMP=$(mktemp) || KTMP=""
    if [ -z "$KTMP" ]; then
        say "PSWS key NOT fanned out: no temp file"
    elif ! KWHY=$(st_read_key "$HK" 2>&1 >"$KTMP"); then
        say "PSWS key NOT fanned out: $KWHY - refused"
    else
        if id hsupload >/dev/null 2>&1 && [ ! -e /etc/hs-uploader/keys/id_ed25519 ] && [ ! -L /etc/hs-uploader/keys/id_ed25519 ]; then
            if st_write_as hsupload 600 /etc/hs-uploader/keys/id_ed25519 < "$KTMP"; then
                runuser -u hsupload -- chgrp sigmond /etc/hs-uploader/keys/id_ed25519 2>/dev/null
                if [ -f "$HK.pub" ] && st_read_key "$HK.pub" public 2>/dev/null \
                        | st_write_as hsupload 644 /etc/hs-uploader/keys/id_ed25519.pub; then
                    runuser -u hsupload -- chgrp sigmond /etc/hs-uploader/keys/id_ed25519.pub 2>/dev/null
                fi
                say "hs-uploader key fanned out: id_ed25519"
            else
                say "hs-uploader key NOT fanned out: could not write /etc/hs-uploader/keys/id_ed25519 as hsupload"
            fi
        elif [ -L /etc/hs-uploader/keys/id_ed25519 ]; then
            say "hs-uploader key NOT fanned out: /etc/hs-uploader/keys/id_ed25519 is a symlink - refused"
        fi
        # timestd owns ~/.ssh, so root must never follow a path there: a link
        # at .ssh or at the key would have had root write the portal key
        # wherever it pointed.  timestd writes it; a symlink is refused.
        TS_SSH=/home/timestd/.ssh
        if id timestd >/dev/null 2>&1 && [ ! -e "$TS_SSH/id_rsa_psws" ] && [ ! -L "$TS_SSH/id_rsa_psws" ]; then
            if [ -L "$TS_SSH" ]; then
                say "grape PSWS key NOT fanned out: $TS_SSH is a symlink - refused"
            elif runuser -u timestd -- sh -c 'umask 077; mkdir -p "$1" && chmod 700 "$1" && [ ! -L "$1" ] && cat > "$1/.id_rsa_psws.new" && mv -f "$1/.id_rsa_psws.new" "$1/id_rsa_psws"' \
                    sh "$TS_SSH" < "$KTMP" 2>/dev/null; then
                say "grape PSWS key fanned out: id_rsa_psws"
            else
                say "grape PSWS key NOT fanned out: could not write $TS_SSH/id_rsa_psws as timestd"
            fi
        elif [ -L "$TS_SSH/id_rsa_psws" ]; then
            say "grape PSWS key NOT fanned out: $TS_SSH/id_rsa_psws is a symlink - refused"
        fi
    fi
    [ -n "$KTMP" ] && rm -f "$KTMP"
fi
# timestd needs the sigmond group to write the shared hs-uploader
# watermark DB from CLI paths (grape upload readonly-database, 2026-08-05)
id timestd >/dev/null 2>&1 && getent group sigmond >/dev/null && usermod -aG sigmond timestd 2>/dev/null
exit 0
