+    # ------------------------------------------------------------------
+    # Archive-drive quota
+    # ------------------------------------------------------------------
+
+    def get_archive_usage(self, incoming_bytes: int = 0) -> Tuple[int, int, float]:
+        """Return (used, capacity, percent) of the archive filesystem as df
+        reports Use%: blocks in use over blocks usable by a non-root user,
+        with ``incoming_bytes`` counted as already written."""
+        st = os.statvfs(self.archive_root)
+        used = (st.f_blocks - st.f_bfree) * st.f_frsize
+        capacity = used + st.f_bavail * st.f_frsize
+        percent = (used + incoming_bytes) / capacity * 100 if capacity else 100.0
+        return used, capacity, percent
+
+    @staticmethod
+    def _tree_bytes(path: Path) -> int:
+        """Disk blocks a tree occupies (what removing it frees)."""
+        total = 0
+        try:
+            for f in [path, *path.rglob('*')]:
+                try:
+                    total += f.lstat().st_blocks * 512
+                except OSError:
+                    pass
+        except OSError:
+            pass
+        return total
+
+    def _archive_eviction_candidates(self) -> List[DayEntry]:
+        """Day-directories on the archive drive in eviction order: every
+        archive_evict_first directory's YYYYMMDD children (oldest first,
+        across all of them), then hf-timestd's own archived raw IQ days
+        (oldest first).  Today and yesterday are never offered."""
+        protected = self._protected_dates_min2()
+        foreign: List[DayEntry] = []
+        for root in self.archive_evict_first:
+            try:
+                children = list(root.iterdir())
+            except OSError as e:
+                logger.warning(f"Archive quota: cannot list {root}: {e}")
+                continue
+            for d in children:
+                if (d.is_dir() and not d.is_symlink()
+                        and _DATE_RE.fullmatch(d.name) and d.name not in protected):
+                    foreign.append(DayEntry(path=d, date_str=d.name,
+                                            category='archive_foreign', is_dir=True))
+        own: List[DayEntry] = []
+        raw_root = self.archive_root / 'raw_buffer'
+        if raw_root.is_dir():
+            for ch in raw_root.iterdir():
+                if not ch.is_dir():
+                    continue
+                for d in ch.iterdir():
+                    if d.is_dir() and _DATE_RE.fullmatch(d.name) and d.name not in protected:
+                        own.append(DayEntry(path=d, date_str=d.name,
+                                            category='archive_raw_iq', is_dir=True))
+        foreign.sort(key=lambda e: (e.date_str, str(e.path)))
+        own.sort(key=lambda e: (e.date_str, str(e.path)))
+        return foreign + own
+
+    def _protected_dates_min2(self) -> set:
+        """Today and yesterday (UTC) — the archive drive's own guard."""
+        today = datetime.now(timezone.utc).date()
+        return {(today - timedelta(days=k)).strftime('%Y%m%d') for k in (0, 1)}
+
+    def enforce_archive_quota(self, incoming_bytes: int = 0) -> dict:
+        """Keep the archive drive below archive_threshold_percent, counting
+        ``incoming_bytes`` about to be moved there, by removing the oldest
+        day-directories (see _archive_eviction_candidates).
+
+        Returns {'evicted', 'bytes_freed', 'initial_percent',
+        'final_percent', 'fits'} — fits is False when the drive would still
+        be at or over the threshold with nothing left to remove."""
+        result = {'evicted': 0, 'bytes_freed': 0, 'initial_percent': None,
+                  'final_percent': None, 'fits': True, 'dry_run': self.dry_run}
+        if (self.archive_threshold_percent is None or not self.archive_root
+                or not self._archive_is_mounted()):
+            return result
+
+        threshold = self.archive_threshold_percent
+        used, capacity, percent = self.get_archive_usage(incoming_bytes)
+        result['initial_percent'] = result['final_percent'] = percent
+        if percent < threshold:
+            return result
+
+        logger.info(f"Archive drive {self.archive_root}: {percent:.1f}% "
+                    f"(with {incoming_bytes / 1024**3:.1f} GB incoming) — "
+                    f"at or over {threshold}%, removing oldest days")
+        simulated_freed = 0
+        for entry in self._archive_eviction_candidates():
+            size = self._tree_bytes(entry.path)
+            if self.dry_run:
+                logger.info(f"[DRY RUN] Would remove from archive: {entry.path} "
+                            f"({size / 1024**3:.2f} GB, {entry.category})")
+                simulated_freed += size
+                percent = (used - simulated_freed + incoming_bytes) / capacity * 100
+            else:
+                try:
+                    shutil.rmtree(entry.path)
+                except OSError as e:
+                    logger.error(f"Archive quota: cannot remove {entry.path}: {e}")
+                    continue
+                logger.info(f"Removed from archive: {entry.path} "
+                            f"({size / 1024**3:.2f} GB, {entry.category})")
+                _, _, percent = self.get_archive_usage(incoming_bytes)
+            result['evicted'] += 1
+            result['bytes_freed'] += size
+            if percent < threshold:
+                break
+
+        result['final_percent'] = percent
+        result['fits'] = percent < threshold
+        if not result['fits']:
+            logger.warning(f"Archive drive {self.archive_root} still {percent:.1f}% "
+                           f"(threshold {threshold}%) with nothing left to remove")
+        logger.info(f"Archive quota: {'would remove' if self.dry_run else 'removed'} "
+                    f"{result['evicted']} day-dirs, "
+                    f"{result['bytes_freed'] / 1024**3:.2f} GB; now {percent:.1f}%")
+        return result
+
