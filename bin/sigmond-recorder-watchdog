#!/usr/bin/env python3
"""sigmond-recorder-watchdog: the one agent besides systemd that restarts
timestd-core-recorder.  The rules, the request format and the ledger are
described in lib/sigmond/recorder_watchdog.py.

Usage: sigmond-recorder-watchdog [--dry-run]
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                "..", "lib"))
from sigmond import recorder_watchdog  # noqa: E402

if __name__ == "__main__":
    sys.exit(recorder_watchdog.main())
