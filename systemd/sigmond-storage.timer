# /etc/systemd/system/sigmond-storage.timer
[Unit]
Description=Storage capacity ledger cadence (every 2 minutes)
Documentation=https://github.com/HamSCI/sigmond

[Timer]
OnCalendar=*:0/2
RandomizedDelaySec=20
# A missed pass needs no catch-up: the next one measures afresh.
Persistent=false

[Install]
WantedBy=timers.target
