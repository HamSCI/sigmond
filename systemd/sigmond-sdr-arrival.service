[Unit]
Description=Sigmond: an RX-888 arrived — finish a bring-up that is waiting for it
# Started by udev (90-sigmond-sdr-arrival.rules) on every RX-888 enumeration.
# The script starts sigmond-firstrun-bringup.service only when the marker says
# the radio half is owed; an ordinary re-enumeration of a working card is a
# silent no-op.  Starting the main unit BY NAME keeps systemd's own dedup: an
# arrival during a running bring-up joins it instead of running a second one.
ConditionPathExists=/etc/sigmond/.personalized

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sigmond-firstrun-bringup --on-sdr-arrival
# v3.72 #13: the card is back, so radiod's consumers get their revive pass
# (reset-failed + start for any that burned their start limit during the
# outage, restart for any older than radiod).  --no-block: the pass can wait
# minutes for radiod and must not hold the bring-up duty above.  The leading
# "-" keeps a refusal from failing this unit.  Gated by the same
# ConditionPathExists, so it runs on personalized stations only.  $$ and %%
# are systemd's escapes for the shell's $ and printf-free text.
ExecStartPost=-/bin/sh -c 'for u in $$(/usr/bin/systemctl list-units --plain --no-legend --all "radiod@*.service" | /usr/bin/cut -d" " -f1); do i=$${u#radiod@}; i=$${i%%.service}; /usr/bin/systemctl --no-block start "sigmond-radiod-consumers@$$i.service"; done'
