# /etc/systemd/system/pm-storage.service
[Unit]
Description=Proxmox-host thin-pool watch: report into each guest, reap expired sigmond snapshots, alarm
Documentation=https://github.com/HamSCI/sigmond

[Service]
Type=oneshot
User=root
Group=root
# root: lvs, `qm delsnapshot` and `pvesh ... agent/file-write` are host-admin
# operations on Proxmox; there is no unprivileged path to them.
ExecStart=/usr/local/sbin/pm-storage.py report
# A deaf guest agent costs one 30 s file-write timeout per VM; a snapshot
# delete on a thin pool takes seconds.  Bound the whole run below the
# timer's 5-minute period.
TimeoutStartSec=240

# Lines carry <N> priority prefixes; one per alarm episode.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pm-storage
