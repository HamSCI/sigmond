# /etc/systemd/system/pm-storage.timer
[Unit]
Description=Proxmox-host thin-pool watch cadence
Documentation=https://github.com/HamSCI/sigmond

[Timer]
OnCalendar=*:0/5
# The guest ledger calls a host report older than 900 s stale; a 5-minute
# period plus 30 s of jitter keeps it fresh with two ticks to spare.
RandomizedDelaySec=30
Persistent=false

[Install]
WantedBy=timers.target
