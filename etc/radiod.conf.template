# /etc/radio/radiod@${INSTANCE_ID}.conf
#
# Generated by `smd config init radiod` (CONTRACT-v0.5 §14).
# This is a minimal config — channel definitions for clients
# (WSPR, FT8, FT4, HFDL, time standards, etc.) are normally
# dropped into:
#
#     /etc/radio/radiod@${INSTANCE_ID}.conf.d/<NN>-<client>.conf
#
# and read in lexical order.  Sigmond does not write channel
# fragments; clients install their own (see psk-recorder,
# wspr-recorder, hfdl-recorder, hf-timestd).

[global]
hardware  = ${FRONTEND}        # which front-end driver to load
status    = ${STATUS_DNS}      # mDNS name for status + control multicast
samprate  = 12000              # default channel output sample rate (Hz) — WSPR/FT8/FT4
                               # recorders request 12000; a 24000 default makes every
                               # channel fail "not verified" under the bring-up burst.
mode      = usb                # default demod mode for unspecified channels
ttl       = 0                  # 0 = loopback-only (single-host default,
                               # safe on every network).  Set to 1 to
                               # publish on the LAN — only safe when an
                               # IGMP-aware switch (with a v2 querier or
                               # snooping) sits between this host and the
                               # consumers.  See `smd diag net` for a
                               # readiness check.
# fft-threads: a DELIBERATE pin, not a preference.  It happens to equal
# radiod's own default (DEFAULT_FFTW_THREADS = 1, radio.c), so it looks
# redundant — it is not.  `fft-threads = 0` runs the forward FFT inline in
# the proc_rx888 USB reader thread, which at 129.6 Msps intermittently
# cannot keep up and SILENTLY drops samples: b4's WSPR decode collapsed to
# 0-1 spots/cycle for 14 hours on 2026-06-01 and recovered the moment it
# was reverted.  Nothing logs it — ka9q's failure_count only prints at
# Verbose>1, so "0 overruns" in the journal is NOT evidence of health.
# Pinned so an upstream default change cannot reintroduce it quietly.
fft-threads = 1
affinity  = false              # let systemd CPUAffinity= confine us
iface     = ${IFACE}           # publish iface — ignored when ttl=0

[${FRONTEND}]
device      = "${FRONTEND}"    # required so this isn't parsed as a demod
description = "${DESCRIPTION}" # callsign + antenna; surfaces in status
${SERIAL_LINE}
${FRONTEND_DEFAULTS}
