# /etc/systemd/system/sigmond-snapshot.timer
[Unit]
Description=station-web snapshot cadence
Documentation=https://github.com/HamSCI/sigmond

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=30
# A snapshot describes the station now; one missed while the host was down
# has nothing to catch up on.  The page marks a snapshot older than 900 s
# stale, so a missed tick shows as missed.
Persistent=false

[Install]
WantedBy=timers.target
