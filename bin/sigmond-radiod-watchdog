#!/usr/bin/env python3
"""sigmond radiod watchdog — detect 'unit active but radiod wedged' and
restart the instance.

Background (Shack2 2026-07-10/11, twice in one evening): on an RX888 USB
stall radiod logs "No rx888 data for 5 seconds, quitting" but then hangs
in libusb shutdown — the process never exits, so systemd's Restart= never
fires and the unit sits `active` for hours while the control plane is
dead.  Every consumer fails downstream (recorders lose SSRCs and flap,
ka9q-web has no session) and nothing self-heals.  A `systemctl restart`
recovers it: the stop forces a USB re-enumeration and the RX888 comes
back clean.

Two detectors, both scoped to the unit's CURRENT invocation:

  1. WEDGED-QUIT: radiod declared "No rx888 data ... quitting" more than
     RWD_GRACE_SEC ago yet the unit is still active.  A radiod that
     announced quitting is in an undefined state even if some threads
     still log — restart it.  (Second Shack2 event: 'quitting' at 22:10,
     sample-rate lines kept coming until 00:23, control plane died with
     them.)

  2. HEARTBEAT-LOST: the unit has been active longer than RWD_WARMUP_SEC
     but has logged NOTHING for RWD_SILENCE_SEC.  A healthy RX888 radiod
     logs its measured-sample-rate line every 60 s; extended total
     silence means the process is hung.

Guards: per-instance cooldown (RWD_COOLDOWN_SEC, /run state) so a truly
broken device can't cause a restart storm; warm-up grace after every
(re)start.  Runs from a 2-minute systemd timer as root.  RWD_DRY_RUN=1
reports without acting.

Additionally (opt-in site policy): honor hf-timestd's radiod restart
REQUEST artifact (/run/hf-timestd/radiod-restart-request.json,
offset-judge spec §9 step 3).  hf-timestd never restarts radiod itself —
when topology.toml [timing] honor_radiod_restart_request = true (default
false) and the request is fresh and schema-valid and names a locally
active radiod@<id>.service, this watchdog performs the restart, logs
CRITICAL with the full evidence, and stamps
/run/sigmond/radiod-restart-honored.json so the same requested_utc is
never honored twice.  See sigmond.timing_judge.process_restart_request
for the full gate.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

GRACE_SEC = int(os.environ.get('RWD_GRACE_SEC', '120'))
SILENCE_SEC = int(os.environ.get('RWD_SILENCE_SEC', '600'))
WARMUP_SEC = int(os.environ.get('RWD_WARMUP_SEC', '300'))
COOLDOWN_SEC = int(os.environ.get('RWD_COOLDOWN_SEC', '600'))
DRY_RUN = os.environ.get('RWD_DRY_RUN', '') not in ('', '0')

STATE_DIR = Path('/run/sigmond-radiod-watchdog')

QUIT_RE = re.compile(r'No rx888 data for .* quitting')


def _run(cmd: list, timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


# A wedged radiod can be slow to die: on AC0G-B4 2026-08-30 systemd needed
# 91 s to finish the stop.  Give the stop room, but never let its outcome
# decide whether the start happens -- see _restart.
STOP_TIMEOUT_SEC = 150


def _active_radiod_units() -> list:
    r = _run(['systemctl', 'list-units', '--type=service', '--state=active',
              '--no-legend', '--plain', '--no-pager', 'radiod@*'])
    return [line.split()[0] for line in r.stdout.splitlines() if line.split()]


def _unit_prop(unit: str, prop: str) -> str:
    r = _run(['systemctl', 'show', unit, '-p', prop, '--value'])
    return r.stdout.strip()


def _epoch(systemd_ts: str) -> float:
    """systemd timestamps like 'Fri 2026-07-10 19:37:24 BST' → epoch."""
    r = _run(['date', '-d', systemd_ts, '+%s'])
    try:
        return float(r.stdout.strip())
    except ValueError:
        return 0.0


def _journal_since_invocation(unit: str, inv_id: str) -> list:
    """Journal lines (with __REALTIME_TIMESTAMP prefix) for the current
    invocation.  Uses the invocation id so lines from prior (possibly
    wedged) runs can't satisfy or trip the detectors."""
    r = _run(['journalctl', f'_SYSTEMD_INVOCATION_ID={inv_id}',
              '--output=short-unix', '--no-pager', '-n', '2000'])
    return r.stdout.splitlines()


def _line_ts(line: str) -> float:
    head = line.split(' ', 1)[0]
    try:
        return float(head)
    except ValueError:
        return 0.0


def _cooldown_ok(unit: str, now: float) -> bool:
    f = STATE_DIR / f'{unit}.last-restart'
    try:
        return now - float(f.read_text().strip()) > COOLDOWN_SEC
    except (OSError, ValueError):
        return True


def _mark_restarted(unit: str, now: float) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR / f'{unit}.last-restart').write_text(f'{now}\n')


# USB ids to hard-reset between stop and start.  A plain restart leaves
# the RX888's FX3 in a stale streaming state and the next radiod start
# trips the driver's 5 s no-data timeout ("No rx888 data ... quitting"),
# re-creating the very condition the watchdog fired on — every plain
# restart on Shack2 2026-07-11 stalled this way, while starts following
# a USBDEVFS_RESET (or a re-plug) came up clean.
RESET_USB_IDS = [s.strip() for s in
                 os.environ.get('RWD_USB_RESET_IDS', '04b4:00f1').split(',')
                 if s.strip()]
_USBDEVFS_RESET = 21780


def _reset_usb_devices() -> None:
    import fcntl
    root = Path('/sys/bus/usb/devices')
    for dev in root.glob('*'):
        try:
            vid = (dev / 'idVendor').read_text().strip()
            pid = (dev / 'idProduct').read_text().strip()
        except OSError:
            continue
        if f'{vid}:{pid}' not in RESET_USB_IDS:
            continue
        try:
            bus = int((dev / 'busnum').read_text())
            num = int((dev / 'devnum').read_text())
            node = f'/dev/bus/usb/{bus:03d}/{num:03d}'
            with open(node, 'wb') as f:
                fcntl.ioctl(f, _USBDEVFS_RESET, 0)
            print(f'  usb-reset {vid}:{pid} at {node}')
        except OSError as exc:
            # A device that dropped off and re-enumerated mid-walk is fine —
            # the disconnect itself is the reset.
            print(f'  usb-reset {vid}:{pid}: {exc} (continuing)')


def _restart(unit: str, reason: str, now: float) -> None:
    print(f'{unit}: {reason} — '
          f'{"DRY-RUN (would restart)" if DRY_RUN else "restarting"}')
    if DRY_RUN:
        return
    _mark_restarted(unit, now)
    # stop → USB reset → settle → start: see RESET_USB_IDS above.
    #
    # Every step before the start is best-effort, and the start is issued
    # unconditionally.  This is not defensive habit, it is the lesson of
    # AC0G-B4 2026-08-30 03:09Z: the stop exceeded its subprocess timeout,
    # TimeoutExpired unwound out of this function, and the start below was
    # never reached.  systemd completed the stop on its own 31 s later, so
    # the unit sat cleanly stopped -- a state Restart=always does not cover,
    # because a deliberate stop is not a failure.  The station was dark for
    # 59 minutes.  A watchdog that can stop a unit without starting it again
    # is worse than no watchdog at all.
    try:
        _run(['systemctl', 'stop', unit], timeout=STOP_TIMEOUT_SEC)
    except subprocess.TimeoutExpired:
        # systemd owns the stop now and will finish it; we must not abandon
        # the unit here.  The start below queues behind the stop job.
        print(f'  {unit}: stop exceeded {STOP_TIMEOUT_SEC}s — '
              f'starting anyway (systemd will finish the stop first)')
    except OSError as exc:
        print(f'  {unit}: stop failed: {exc} — starting anyway')
    try:
        _reset_usb_devices()
    except Exception as exc:        # noqa: BLE001 — never block the start
        print(f'  usb-reset: {exc} (continuing)')
    time.sleep(3)
    _run(['systemctl', 'start', unit])


def check_unit(unit: str, now: float) -> None:
    inv_id = _unit_prop(unit, 'InvocationID')
    active_since = _epoch(_unit_prop(unit, 'ActiveEnterTimestamp'))
    if not inv_id or not active_since:
        return
    age = now - active_since
    if age < WARMUP_SEC:
        return                      # still starting up — leave it alone
    if not _cooldown_ok(unit, now):
        print(f'{unit}: in restart cooldown — skipping')
        return

    lines = _journal_since_invocation(unit, inv_id)
    last = max((_line_ts(l) for l in lines), default=active_since)
    quit_ts = max((_line_ts(l) for l in lines if QUIT_RE.search(l)),
                  default=0.0)

    # Detector 1: declared quitting but still active past the grace
    # window.  A radiod that logged the quitting line is ALWAYS
    # compromised, even when sample-rate logging resumes: the rx888
    # thread's shutdown tears down the control/status plane, so the
    # process streams on half-alive with every consumer's channel
    # commands going unanswered (observed on Shack2 2026-07-10 22:10 —
    # 2 h of sample-rate lines with dead control — and again on every
    # post-restart instance of 2026-07-11).  Do NOT require log silence
    # here; the restart path below resets the USB device so the next
    # start doesn't re-trip the 5 s no-data transient that caused the
    # earlier restart loop.
    if quit_ts and now - quit_ts > GRACE_SEC:
        _restart(unit, 'declared "no rx888 data, quitting" '
                       f'{int(now - quit_ts)}s ago but still active '
                       '(half-alive: control plane down)', now)
        return

    # Detector 2: total log silence from a long-running unit.
    if now - last > SILENCE_SEC:
        _restart(unit, f'no journal output for {int(now - last)}s '
                       '(heartbeat lost)', now)


RESTART_REQUEST_PATH = Path('/run/hf-timestd/radiod-restart-request.json')


def _honor_restart_request(now: float) -> None:
    """Opt-in honoring of hf-timestd's restart request (spec §9 step 3).

    Fast-exits when the artifact is absent (the overwhelmingly common
    case) so the sigmond lib import cost is only paid during an actual
    escalation.  Never deletes the artifact — hf-timestd withdraws it
    itself once the fault clears.
    """
    if not RESTART_REQUEST_PATH.exists():
        return
    # The installed /usr/local/bin symlink resolves into the repo, so
    # lib/ sits beside bin/ after resolution — same bootstrap as smd.
    lib = Path(__file__).resolve().parent.parent / 'lib'
    if str(lib) not in sys.path:
        sys.path.insert(0, str(lib))
    try:
        from sigmond.timing_judge import process_restart_request
        from sigmond.topology import load_topology
    except Exception as exc:        # noqa: BLE001 — wedge detection must go on
        print(f'restart-request: {RESTART_REQUEST_PATH} present but sigmond '
              f'lib unavailable ({exc}) — skipping', file=sys.stderr)
        return
    enabled = bool(load_topology().timing.get('honor_radiod_restart_request'))
    decision = process_restart_request(
        enabled, request_path=RESTART_REQUEST_PATH, now=now, act=not DRY_RUN)
    if decision.action == 'restart':
        # CRITICAL, with the request's full evidence, via journald's
        # syslog-level prefix (SyslogLevelPrefix= defaults to true).
        print(f'<2>CRITICAL: {decision.reason} — request evidence: '
              f'{json.dumps(decision.request, sort_keys=True)}')
        if not DRY_RUN and decision.unit:
            # Share the wedge-detectors' cooldown so they leave the
            # freshly restarted unit alone through warm-up.
            _mark_restarted(decision.unit, now)
    elif decision.loud:
        print(f'<3>restart-request: {decision.reason}')
    elif decision.action != 'none':
        print(f'restart-request: {decision.reason}')


def main() -> int:
    now = time.time()
    try:
        _honor_restart_request(now)
    except Exception as exc:        # noqa: BLE001 — watchdog must not die
        print(f'restart-request: check failed: {exc}', file=sys.stderr)
    units = _active_radiod_units()
    if not units:
        return 0                    # no radiod on this host — no-op
    for unit in units:
        try:
            check_unit(unit, now)
        except Exception as exc:    # noqa: BLE001 — watchdog must not die
            print(f'{unit}: watchdog check failed: {exc}', file=sys.stderr)
    return 0


if __name__ == '__main__':
    sys.exit(main())
