# /etc/systemd/system/sigmond-snapshot-request.service
[Unit]
Description=Refresh the check snapshot on station-web's request
Documentation=https://github.com/HamSCI/sigmond
# Started by sigmond-snapshot-request.path.  `--request` consumes every
# waiting request, then refreshes once; inside 30 s of the last requested
# refresh it waits out the rest of the 30 s first, so no request is dropped.

[Service]
Type=oneshot
User=root
Group=root
Nice=19
IOWeight=10
ExecStart=/usr/local/bin/smd admin snapshot write --request

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sigmond-snapshot
